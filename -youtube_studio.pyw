        ]
        self.dt_thumb = DataTab(parent, self, cols,
                                get_model=lambda: self.prof.setdefault("thumbnails", []),
                                recompute=self._recompute_thumb, output_key="prompt", unit="thumbnail")
        self.dt_thumb.pack(fill="both", expand=True)
