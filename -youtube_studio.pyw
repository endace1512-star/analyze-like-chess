# ── HTTP (stdlib, không cần thư viện ngoài) ──────────────────────────────────
# QUAN TRỌNG: api.ai84.pro và cdn.ai84.pro nằm sau Cloudflare. Nếu request KHÔNG
# có User-Agent kiểu trình duyệt, Cloudflare chặn với "HTTP 403 - error code 1010"
# (banned based on browser signature) — đây chính là lỗi 403/1010 trước đây.
# Gắn sẵn User-Agent + Accept cho mọi request là đủ để vượt qua.
_BROWSER_UA = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
               "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36")


def _http_json(method, url, headers=None, body=None, timeout=60):
    data = None
    h = dict(headers or {})
    h.setdefault("User-Agent", _BROWSER_UA)
    h.setdefault("Accept", "application/json")
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        h.setdefault("Content-Type", "application/json")
    req = urllib.request.Request(url, data=data, headers=h, method=method)
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
            raw = resp.read()
            status = resp.status
    except urllib.error.HTTPError as e:
        raw = e.read()
        status = e.code
    try:
        parsed = json.loads(raw.decode("utf-8"))
    except Exception:
        parsed = None
    if status >= 400:
        msg = ""
        if isinstance(parsed, dict):
            msg = parsed.get("error") or parsed.get("message") or parsed.get("detail") or ""
        raise RuntimeError(f"HTTP {status}: {msg or raw[:200].decode('utf-8', 'replace')}")
    if parsed is None:
        raise RuntimeError("Phản hồi không phải JSON.")
    return parsed


def _http_download(url, path, timeout=180):
    # CDN cũng sau Cloudflare → vẫn cần User-Agent kiểu trình duyệt.
    req = urllib.request.Request(url, headers={"User-Agent": _BROWSER_UA})
    ctx = ssl.create_default_context()
    with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp, open(path, "wb") as f:
        shutil.copyfileobj(resp, f)


def _extract_task_result(jr):
    """Đọc (status, audio_url, srt_url, error) từ MỌI kiểu phản hồi của ai84.pro.

    Các endpoint trả về khác cấu trúc nhau:
      • GET /v1/task/{id}                         -> {"data": {"status", "metadata": {...}}}
      • GET /v1/minimax/text-to-speech/async/{id} -> {"job": {"status", "audio_url", ...}}
      • GET /v2/text-to-speech/async/{id}         -> {"job": {"status", "audio_url", ...}}
    Trước đây code chỉ đọc tầng ngoài cùng nên với /v1/task luôn ra status=None
    (vì status thật nằm trong "data") → chờ vô hạn dù job đã xong.
    """
    if not isinstance(jr, dict):
        return "", "", "", ""
    node = jr.get("data") or jr.get("job") or jr
    if not isinstance(node, dict):
        node = jr
    meta = node.get("metadata") if isinstance(node.get("metadata"), dict) else {}
    status = str(node.get("status") or jr.get("status") or "").lower()
    audio_url = (meta.get("audio_url") or node.get("audio_url")
                 or jr.get("audio_url") or "")
    srt_url = (meta.get("srt_url") or meta.get("transcript_url")
               or node.get("srt_url") or node.get("transcript_url")
               or _deep_find_srt_url(jr) or "")
    err = (node.get("error_message") or node.get("error")
           or jr.get("error_message") or jr.get("error") or "")
    return status, audio_url, srt_url, err


# ── Tìm & dựng phụ đề SRT từ mọi kiểu phản hồi TTS ───────────────────────────
# api.ai84.pro (proxy MiniMax/ElevenLabs) trả phụ đề theo nhiều kiểu khác nhau:
# có thể là URL file .srt, hoặc SRT thô inline, hoặc chỉ có dữ liệu timing
# (alignment ký tự của ElevenLabs / danh sách words / segments). Bộ hàm dưới đây
# tự dò URL ở mọi cấp, và nếu không có file thì DỰNG SRT tại chỗ từ timing.
def _looks_like_url(s):
    return isinstance(s, str) and (s[:7] == "http://" or s[:8] == "https://"
                                   or (s[:1] == "/" and " " not in s and len(s) < 400))


def _fmt_srt_ts(sec):
    try:
        sec = float(sec)
    except Exception:
        sec = 0.0
    if sec < 0:
        sec = 0.0
    ms = int(round(sec * 1000))
    h, ms = divmod(ms, 3600000)
    m, ms = divmod(ms, 60000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def _collect_srt_urls(obj, out, _d=0):
    if _d > 7 or obj is None:
        return
    if isinstance(obj, dict):
        for k, v in obj.items():
            kl = str(k).lower()
            if _looks_like_url(v):
                pr = 0
                if "srt" in kl:
                    pr = 3
                elif "subtitle" in kl or "caption" in kl:
                    pr = 2
                elif "transcript" in kl or kl == "sub_url":
                    pr = 1
                if pr:
                    out.append((pr, v))
            else:
                _collect_srt_urls(v, out, _d + 1)
    elif isinstance(obj, list):
        for v in obj:
            _collect_srt_urls(v, out, _d + 1)


def _deep_find_srt_url(jr):
    """Tìm URL phụ đề ở mọi cấp; ưu tiên srt > subtitle/caption > transcript."""
    out = []
    _collect_srt_urls(jr, out)
    if not out:
        return ""
    out.sort(key=lambda x: -x[0])
    return out[0][1]


def _deep_find_srt_text(obj, _d=0):
    """Tìm nội dung SRT thô (chuỗi có '-->') nằm trực tiếp trong phản hồi."""
    if _d > 7 or obj is None:
        return ""
    if isinstance(obj, str):
        return obj if ("-->" in obj and "\n" in obj) else ""
    if isinstance(obj, dict):
        for v in obj.values():
            t = _deep_find_srt_text(v, _d + 1)
            if t:
                return t
    elif isinstance(obj, list):
        for v in obj:
            t = _deep_find_srt_text(v, _d + 1)
            if t:
                return t
    return ""


def _cues_to_srt(cues):
    lines, idx = [], 1
    for start, end, text in cues:
        text = " ".join(str(text).split())
        if not text:
            continue
        if end is None or end <= start:
            end = start + max(1.2, len(text) * 0.06)
        lines.append(str(idx))
        lines.append(f"{_fmt_srt_ts(start)} --> {_fmt_srt_ts(end)}")
        lines.append(text)
        lines.append("")
        idx += 1
    return ("\n".join(lines).strip() + "\n") if lines else ""


def _find_alignment(obj, _d=0):
    """Tìm khối alignment ký tự kiểu ElevenLabs."""
    if _d > 7 or not isinstance(obj, (dict, list)):
        return None
    if isinstance(obj, dict):
        for key in ("alignment", "normalized_alignment"):
            a = obj.get(key)
            if isinstance(a, dict) and a.get("characters") and \
               (a.get("character_start_times_seconds") or a.get("character_start_times")):
                return a
        if obj.get("characters") and \
           (obj.get("character_start_times_seconds") or obj.get("character_start_times")):
            return obj
        for v in obj.values():
            r = _find_alignment(v, _d + 1)
            if r:
                return r
    else:
        for v in obj:
            r = _find_alignment(v, _d + 1)
            if r:
                return r
    return None


def _srt_from_alignment(al):
    """Dựng SRT từ alignment ký tự: gom ký tự thành cue theo dấu câu / khoảng lặng / độ dài."""
    chars = al.get("characters") or []
    st = al.get("character_start_times_seconds") or al.get("character_start_times") or []
    en = al.get("character_end_times_seconds") or al.get("character_end_times") or []
    n = min(len(chars), len(st), len(en))
    if n == 0:
        return ""
    cues, buf = [], []
    c_start = None
    last_end = None

    def flush():
        nonlocal buf, c_start, last_end
        text = "".join(buf).strip()
        if text and c_start is not None:
            cues.append((c_start, last_end if last_end is not None else c_start, text))
        buf, c_start, last_end = [], None, None

    for i in range(n):
        ch = chars[i] if isinstance(chars[i], str) else ""
        s, e = st[i], en[i]
        if c_start is None:
            if ch.strip() == "":
                continue
            c_start = s
        elif last_end is not None and isinstance(s, (int, float)) and \
                (s - last_end) > 0.7 and "".join(buf).strip():
            flush()
            if ch.strip() == "":
                continue
            c_start = s
        buf.append(ch)
        last_end = e
        stripped = "".join(buf).strip()
        if (stripped and stripped[-1] in ".!?…" and len(stripped) >= 12) or len(stripped) >= 90:
            flush()
    flush()
    return _cues_to_srt(cues)


def _seg_time(d, keys):
    for k in keys:
        if k in d and d[k] is not None:
            try:
                val = float(d[k])
            except Exception:
                continue
            if k.lower().endswith("ms"):
                val /= 1000.0
            return val
    return None


def _merge_word_cues(cues):
    out, buf = [], []
    start = None
    last_end = None
    for s, e, t in cues:
        if start is None:
            start = s
        buf.append(t)
        last_end = e if e is not None else last_end
        joined = " ".join(buf)
        if (joined and joined[-1] in ".!?…" and len(joined) >= 12) or len(joined) >= 80:
            out.append((start, last_end, joined))
            buf, start, last_end = [], None, None
    if buf:
        out.append((start, last_end, " ".join(buf)))
    return out


def _find_segments(obj, _d=0):
    """Tìm danh sách segments/words/sentences có kèm thời gian."""
    if _d > 7 or not isinstance(obj, (dict, list)):
        return None
    if isinstance(obj, dict):
        for key in ("segments", "words", "chunks", "subtitles", "sentences"):
            seg = obj.get(key)
            if isinstance(seg, list) and seg and isinstance(seg[0], dict):
                d0 = seg[0]
                if any(k in d0 for k in ("start", "start_time", "start_seconds",
                                         "begin", "start_ms", "startMs", "from")):
                    return seg
        for v in obj.values():
            r = _find_segments(v, _d + 1)
            if r:
                return r
    else:
        for v in obj:
            r = _find_segments(v, _d + 1)
            if r:
                return r
    return None


def _srt_from_segments(segs):
    cues = []
    for d in segs:
        if not isinstance(d, dict):
            continue
        text = (d.get("text") or d.get("word") or d.get("content")
                or d.get("value") or d.get("sentence") or "")
        if not isinstance(text, str) or not text.strip():
            continue
        s = _seg_time(d, ("start", "start_time", "start_seconds", "begin",
                          "start_ms", "startMs", "from"))
        e = _seg_time(d, ("end", "end_time", "end_seconds", "finish",
                          "end_ms", "endMs", "to"))
        if s is None:
            continue
        cues.append((s, e, text.strip()))
    if cues:
        single_word = sum(1 for c in cues if " " not in c[2].strip())
        if single_word >= 0.6 * len(cues) and len(cues) >= 6:
            cues = _merge_word_cues(cues)
    return _cues_to_srt(cues)


def _build_srt_text(jr):
    """Dựng nội dung SRT từ mọi dữ liệu có sẵn (inline SRT / alignment / segments). '' nếu không có."""
    t = _deep_find_srt_text(jr)
    if t:
        return t.strip() + "\n"
    al = _find_alignment(jr)
    if al:
        t = _srt_from_alignment(al)
        if t.strip():
            return t
    segs = _find_segments(jr)
    if segs:
        t = _srt_from_segments(segs)
        if t.strip():
            return t
    return ""


def _srt_content_from(srt_url, jr):
    """Trả về NỘI DUNG SRT thật (có mốc '-->') lấy từ URL phụ đề hoặc từ phản hồi job.
    KHÔNG ghi file. '' nếu không dựng được. Dùng cho luồng 'giữ SRT trong bộ nhớ rồi
    XUẤT sau'. Nếu URL trả về JSON transcript (không phải .srt sẵn) thì parse & dựng SRT."""
    # A) Có URL phụ đề → tải nội dung vào bộ nhớ, không đụng file đích.
    if srt_url:
        tmp = os.path.join(tempfile.gettempdir(), "_srt_probe.download")
        raw = ""
        try:
            _http_download(srt_url, tmp)
            try:
                raw = Path(tmp).read_text(encoding="utf-8", errors="replace")
            except Exception:
                raw = ""
        except Exception:
            raw = ""
        finally:
            try:
                if os.path.exists(tmp):
                    os.remove(tmp)
            except Exception:
                pass
        if raw:
            if "-->" in raw:                    # đã là file .srt
                return raw.strip() + "\n"
            try:
                parsed = json.loads(raw)        # transcript JSON → dựng SRT
            except Exception:
                parsed = None
            if parsed is not None:
                t = _build_srt_text(parsed)
                if t.strip():
                    return t
    # B) Không có URL dùng được → dựng từ chính phản hồi job (inline / alignment / segments).
    t = _build_srt_text(jr)
    return t if t.strip() else ""


# ── Khớp tên file ảnh ref ↔ nhân vật trong tab CHARACTER ─────────────────────
def _norm_match(s):
    """Chuẩn hoá để so khớp: chữ thường, chỉ giữ a-z0-9."""
    return re.sub(r"[^a-z0-9]+", "", (s or "").lower())


def _img_desc_key(filename):
    """Lấy phần MÔ TẢ ở giữa tên file ảnh gen ra để đem so khớp.

    Bỏ số thứ tự ở đầu (vd '23_') và đuôi biến thể ('_s1'…'_s9'), rồi chuẩn hoá.
      '23_Single_clean_character_model_r_s4.jpg' -> 'singlecleancharactermodelr'
      '1_Small_cold_stone_chamber_insid_s1.png'  -> 'smallcoldstonechamberinsid'
      '2_A_cozy_small_apartment_living_s2_2K.jpg' -> 'acozysmallapartmentliving'
    """
    stem = Path(filename).stem
    stem = re.sub(r"^\s*\d+[_\-\s]*", "", stem)          # bỏ số đầu
    # bỏ _sN, kèm đuôi độ phân giải G-Labs thêm từ 26/09/2026 (_s1_2K, _s3_4K)
    stem = re.sub(r"[_\-\s]*s\d+(?:[_\-\s]*\d+k)?\s*$", "", stem, flags=re.IGNORECASE)
    return _norm_match(stem)


def _best_char_match(key, cand):
    """key = mô tả từ tên file; cand = [(alias, norm_text)]. Trả alias khớp tốt nhất.

    Quy tắc: subject giờ đứng ĐẦU ref_prompt, nên ưu tiên ứng viên mà text BẮT ĐẦU
    bằng key (chính xác hơn "chứa"); nếu không ai bắt đầu bằng key thì fallback về
    "chứa" (tương thích cách cũ). Nhiều ứng viên khớp → chọn text dài nhất. Key quá
    ngắn → bỏ qua cho an toàn.
    """
    if len(key) < 6:
        return None
    prefixed = [(a, t) for a, t in cand if t.startswith(key)]
    pool = prefixed if prefixed else [(a, t) for a, t in cand if key in t]
    best, best_len = None, -1
    for alias, text in pool:
        if len(text) > best_len:
            best, best_len = alias, len(text)
    return best


