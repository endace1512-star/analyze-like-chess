    def _concept_bg_names(self):
        """Tên nền CONCEPT (vd fred-white): bg_name của protagonist có tick 'DÙNG CONCEPT'."""
        out = set()
        for p in self.prof.get("protagonists", []):
            nm = (p.get("bg_name") or "").strip().lower()
            if p.get("use_concept") and nm:
                out.add(nm)
        return out

    def _write_prompt_scenes_json(self, path):
        """Ghi danh sách scene (id, vo, bg, action, kind) — id đánh số theo VỊ TRÍ dòng ở tab
        PROMPT (giống scene-list.csv) để khớp ảnh 001.jpg, 002.jpg…"""
        cbgs = self._concept_bg_names()
        rows = []
        for i, s in enumerate(self.prof.get("prompts", [])):
            vo = (s.get("vo") or "").strip()
            if not vo:
                continue
            bg = (s.get("bg") or "").strip()
            rows.append({"id": f"{i+1:03d}", "vo": vo, "bg": bg,
                         "action": s.get("action", "") or "",
                         "kind": "concept" if bg.lower() in cbgs else "scene"})
        Path(path).write_text(json.dumps(rows, ensure_ascii=False, indent=1), encoding="utf-8")
        return len(rows)

    def _run_makedraft(self):
        """Nút SINH DRAFT CAPCUT: align như cũ rồi sinh thẳng draft CapCut (không cần ffmpeg).
        Nút ALIGN + BUILD cũ giữ nguyên."""
        if not self._guard_busy():
            return
        if not DRAFT_SCRIPT.is_file():
            return self._warn(f"Không thấy file {DRAFT_SCRIPT.name} cạnh app.\n\n"
                              f"Cần có fky_make_draft.py + fky_draft_builder.py trong:\n{DRAFT_SCRIPT.parent}")
        srt = _clean_path(self.v_srt.get())
        if not srt or not Path(srt).is_file():
            return self._warn("Chọn file SRT (sub.srt) hợp lệ.")
        images = _clean_path(self.v_images.get())
        if not images or not Path(images).is_dir():
            return self._warn("Chưa có 'Folder ảnh' hợp lệ. Chọn folder chứa ảnh 001.jpg, 002.jpg… "
                              "ở ô 'Folder ảnh' TRÊN CÙNG của tab MEDIA.")
        # VO.mp3 BẮT BUỘC (draft cần audio đầy đủ + tổng thời lượng)
        audio = _clean_path(self.v_audio.get()) if hasattr(self, "v_audio") else ""
        if not audio:
            srtdir = Path(srt).parent
            cand = srtdir / "VO.mp3"
            if cand.is_file():
                audio = str(cand)
            else:
                mp3s = sorted(srtdir.glob("*.mp3"))
                if len(mp3s) == 1:
                    audio = str(mp3s[0])
            if audio:
                self.v_audio.set(audio)
        if not (audio and Path(audio).is_file()):
            return self._warn("Cần file Audio VO (mp3) để sinh draft CapCut.\n"
                              "Chọn ở ô 'Audio VO (mp3)' (hoặc đặt VO.mp3 cạnh file SRT).")
        name = (self.v_draft_name.get() or "").strip()
        if not name:
            name = simpledialog.askstring("TÊN DRAFT", "Tên draft CapCut (tên tập):",
                                          parent=self, initialvalue=self.prof.get("name", "episode"))
            if not name:
                return
            name = name.strip()
            self.v_draft_name.set(name)
        name = re.sub(r'[\\/:*?"<>|]+', "_", name)
        draft_root = Path(os.environ.get("LOCALAPPDATA", "")) / "CapCut" / "User Data" / "Projects" / "com.lveditor.draft"
        if (draft_root / name).exists():
            if not messagebox.askyesno("GHI ĐÈ DRAFT?",
                                       f"Draft '{name}' đã có trong CapCut. Ghi đè?\n\n"
                                       "(Mọi chỉnh sửa tay trong draft đó sẽ mất.)"):
                return
        tmp = Path(tempfile.gettempdir()) / "youtube_studio_scenes.json"
        n = self._write_prompt_scenes_json(tmp)
        if n == 0:
            return self._warn("Tab PROMPT chưa có scene nào có VO. Nhập SCENES trước.")
        self._log_line(f"(scene lấy từ tab PROMPT: {n} scene → {tmp})")
        font = _clean_path(self.prof.get("font_path", "") or "")
        if font and not Path(font).is_file():
            self._log_line(f"⚠️  Không thấy font: {font} → dùng System.")
            font = ""
        res = (self.v_res.get().strip() or "1920x1080").lower().split("x")
        try:
            w, h = int(res[0]), int(res[1])
        except Exception:
            w, h = 1920, 1080
        cmd = [PY, "-u", str(DRAFT_SCRIPT),
               "--scenes-json", str(tmp), "--srt", srt, "--audio", audio,
               "--images", images, "--draft-name", name,
               "--draft-root", str(draft_root),
               "--align-script", str(MAKEVIDEO_SCRIPT),
               "--width", str(w), "--height", str(h)]
        if font:
            cmd += ["--font", font]
        self._spawn(cmd, label=f"Sinh draft CapCut '{name}'", cwd=str(Path(srt).parent))

    # ═════════ PROFILE ═════════
    def _on_profile_select(self, _e=None):
        name = self.profile_var.get()
        if name and name != self.prof["name"]:
            self._switch_to(name)

    def _switch_to(self, name):
        self._cfg_leave_if_editing()
        self._sync_style_from_widgets()
        self._sync_vo_from_widgets()
        self._vo_sync_settings_from_widgets()
        save_profile(self.prof)
        self.prof = load_profile(name)
        self.profile_var.set(self.prof["name"])
        save_last_profile(self.prof["name"])
        for dt in (self.dt_chars, self.dt_bg, self.dt_prompts, self.dt_thumb):
            dt.checked.clear()
        self.refresh_all()
        self._set_status(f"Đã chuyển sang hồ sơ '{self.prof['name']}'.")

    def _new_profile(self):
        name = simpledialog.askstring("HỒ SƠ MỚI", "Tên hồ sơ kênh mới:", parent=self)
        if not name:
            return
        name = name.strip()
        if name in list_profiles():
            return messagebox.showwarning("TRÙNG", f"Đã có hồ sơ '{name}'.")
        self._cfg_leave_if_editing()
        self._sync_style_from_widgets()
        self._sync_vo_from_widgets()
        self._vo_sync_settings_from_widgets()
        save_profile(self.prof)
        save_profile(_empty_profile(name))
        self.prof = load_profile(name)
        self._refresh_profile_combo()
        self.profile_var.set(name)
        save_last_profile(name)
        for dt in (self.dt_chars, self.dt_bg, self.dt_prompts, self.dt_thumb):
            dt.checked.clear()
        self.refresh_all()
        self._set_status(f"Đã tạo hồ sơ '{name}'.")

    def _rename_profile(self):
        old = self.prof["name"]
        name = simpledialog.askstring("ĐỔI TÊN HỒ SƠ", "Tên mới:", initialvalue=old, parent=self)
        if not name:
            return
        name = name.strip()
        if name == old:
            return
        if name in list_profiles():
            return messagebox.showwarning("TRÙNG", f"Đã có hồ sơ '{name}'.")
        self._cfg_leave_if_editing()
        self._sync_style_from_widgets()
        self._sync_vo_from_widgets()
        self._vo_sync_settings_from_widgets()
        self.prof["name"] = name
        save_profile(self.prof)
        delete_profile(old)
        self._refresh_profile_combo()
        self.profile_var.set(name)
        save_last_profile(name)
        self._set_status(f"Đã đổi tên '{old}' → '{name}'.")

    def _delete_profile(self):
        if len(list_profiles()) <= 1:
            return messagebox.showwarning("KHÔNG THỂ", "Phải còn ít nhất 1 hồ sơ.")
        self._cfg_leave_if_editing()
        cur = self.prof["name"]
        if not messagebox.askyesno("XÁC NHẬN XOÁ", f"Xoá hồ sơ '{cur}'? (không hoàn tác)"):
            return
        delete_profile(cur)
        nxt = list_profiles()[0]
        self.prof = load_profile(nxt)
        self._refresh_profile_combo()
        self.profile_var.set(self.prof["name"])
        save_last_profile(self.prof["name"])
        for dt in (self.dt_chars, self.dt_bg, self.dt_prompts, self.dt_thumb):
            dt.checked.clear()
        self.refresh_all()
        self._set_status(f"Đã xoá '{cur}', chuyển sang '{self.prof['name']}'.")

    def _refresh_profile_combo(self):
        self.profile_cb.configure(values=list_profiles())

    # ═════════ REFRESH / AUTOSAVE ═════════
    def refresh_data_tabs(self):
        self.dt_chars.refresh()
        self.dt_bg.refresh()
        self.dt_prompts.refresh()
        self.dt_thumb.refresh()

    def refresh_all(self):
        self._load_style_into_widgets()
        self._load_vo_into_widgets()
        self._vo_load_settings_into_widgets()
        self.refresh_data_tabs()
        self._refresh_profile_combo()

    def on_data_changed(self):
        self.refresh_data_tabs()
        self._dirty()

    def _dirty(self):
        if self._save_job is not None:
            try:
                self.after_cancel(self._save_job)
            except Exception:
                pass
        self._save_job = self.after(600, self._flush_save)

    def _flush_save(self):
        self._save_job = None
        if not self.cfg_editing:      # đang sửa Channel Config: chỉ ghi model khi bấm LƯU
            self._sync_style_from_widgets()
        self._sync_vo_from_widgets()
        self._vo_sync_settings_from_widgets()
        try:
            save_profile(self.prof)
            save_last_profile(self.prof["name"])
        except Exception as e:
            self._set_status(f"Lỗi lưu: {e}")

    def _set_status(self, msg):
        self.status.configure(text=msg)

    # ═════════ UNDO / REDO (Ctrl+Z / Ctrl+Y) — dữ liệu các bảng ═════════
    def _snapshot(self):
        """Chụp 4 bảng dữ liệu TRƯỚC một thao tác sửa/xoá/nhập để có thể Ctrl+Z."""
        snap = {k: copy.deepcopy(self.prof.get(k, [])) for k in self._UNDO_KEYS}
        self._undo_stack.append(snap)
        if len(self._undo_stack) > 60:
            self._undo_stack.pop(0)
        self._redo_stack.clear()

    def _restore_snapshot(self, snap):
        for k in self._UNDO_KEYS:
            self.prof[k] = snap.get(k, [])
        for dt in (self.dt_chars, self.dt_bg, self.dt_prompts, self.dt_thumb):
            dt.checked.clear()
        self.refresh_data_tabs()
        self._dirty()

    def _typing_focus(self):
        # đang gõ trong ô nhiều dòng / entry -> Ctrl+Z là undo văn bản của ô đó, không đụng data
        return isinstance(self.focus_get(), (tk.Text, tk.Entry))

    def _undo(self, event=None):
        if self._typing_focus():
            return
        if not self._undo_stack:
            self._set_status("Không có gì để hoàn tác.")
            return "break"
        cur = {k: copy.deepcopy(self.prof.get(k, [])) for k in self._UNDO_KEYS}
        self._redo_stack.append(cur)
        self._restore_snapshot(self._undo_stack.pop())
        self._set_status("Đã hoàn tác (Ctrl+Z).")
        return "break"

    def _redo(self, event=None):
        if self._typing_focus():
            return
        if not self._redo_stack:
            self._set_status("Không có gì để làm lại.")
            return "break"
        cur = {k: copy.deepcopy(self.prof.get(k, [])) for k in self._UNDO_KEYS}
        self._undo_stack.append(cur)
        self._restore_snapshot(self._redo_stack.pop())
        self._set_status("Đã làm lại (Ctrl+Y).")
        return "break"

    # ═════════ MEDIA RUNNERS ═════════
    def _run_rename_asset(self):
        """Nút ĐỔI TÊN ẢNH ASSET ở tab ASSET. Chỉ còn character / background —
        ảnh scene đổi tên ở tab MEDIA theo tab PROMPT."""
        folder = _clean_path(self.rn_folder.get())
        if not folder or not Path(folder).is_dir():
            return self._warn("Folder ảnh asset không hợp lệ.\n\n"
                              "Chọn ở ô 'Folder ảnh asset' ngay trên khung này (tab ASSET).")
        return self._rename_by_asset("bg" if self.rn_asset_kind.get() == "background" else "char")

    def _rename_by_asset(self, kind):
        """Đổi tên ảnh ref DỰA VÀO tab ASSET: khớp đầu prompt (nằm trong tên file ảnh gen ra)
        với từng asset → đặt đúng tên. kind='char' → character1/character2…; kind='bg' → tên background."""
        folder = Path(_clean_path(self.rn_folder.get()))
        if kind == "char":
            rows = self._locked_chars() + self._recompute_chars(self.prof.setdefault("characters", []))
            cand = [(c.get("alias", ""), _norm_match((c.get("ref_prompt") or c.get("subject") or "").strip()))
                    for c in rows]
            empty_msg = ("Tab ASSET (CHARACTER) chưa có nhân vật nào có nội dung.\n"
                         "→ Bấm NHẬP ASSET để nạp bảng CHARACTER trước.")
            label = "CHARACTER"
        else:
            rows = self._locked_bg() + self._recompute_bg(self.prof.setdefault("backgrounds", []))
            cand = [(c.get("t_goc", ""), _norm_match((c.get("ref_prompt") or c.get("subject") or "").strip()))
                    for c in rows]
            empty_msg = "Tab ASSET (BACKGROUND) chưa có background nào có nội dung."
            label = "BACKGROUND"
        cand = [(t, k) for (t, k) in cand if t and k]
        if not cand:
            return self._warn(empty_msg)
        exts = {".png", ".jpg", ".jpeg", ".webp", ".bmp"}
        imgs = sorted([p for p in folder.iterdir() if p.is_file() and p.suffix.lower() in exts],
                      key=lambda p: p.name.lower())
        if not imgs:
            return self._warn("Folder ảnh không có ảnh.")

        by_target, unmatched = {}, []
        for p in imgs:
            best = _best_char_match(_img_desc_key(p.name), cand)
            (unmatched if best is None else by_target.setdefault(best, [])).append(
                p.name if best is None else p)

        plan = []   # (old_path, new_name)
        for target, files in by_target.items():
            if len(files) == 1:
                plan.append((files[0], target + files[0].suffix.lower()))
            else:                       # còn nhiều biến thể → giữ đuôi _sN cho khỏi đè
                for k, p in enumerate(files):
                    m = re.search(r"(_s\d+)", p.stem, re.IGNORECASE)
                    suf = m.group(1).lower() if m else f"_{k+1}"
                    plan.append((p, f"{target}{suf}{p.suffix.lower()}"))

        plan = [(o, n) for (o, n) in plan if o.name != n]
        if not plan:
            msg = "Không ảnh nào cần đổi (đã đúng tên hoặc không khớp asset nào)."
            if unmatched:
                msg += f"\nKhông khớp: {len(unmatched)} ảnh."
            return self._warn(msg)

        lines = [f"  {o.name}  →  {n}" for o, n in plan[:25]]
        if len(plan) > 25:
            lines.append(f"  … (+{len(plan)-25} ảnh nữa)")
        extra = f"\n\n{len(unmatched)} ảnh KHÔNG khớp asset nào (giữ nguyên)." if unmatched else ""
        if not messagebox.askyesno(f"ĐỔI TÊN theo tab ASSET ({label})?",
                f"Sẽ đổi {len(plan)} ảnh:\n\n" + "\n".join(lines) + extra +
                "\n\nĐỔI TÊN file thật trên ổ đĩa (khó undo). Tiếp tục?"):
            return

        self._log_line(f"\n▶ Đổi tên theo tab ASSET / {label} ({folder})")
        tmps, ok = [], 0
        for k, (old, new) in enumerate(plan):
            tmp = old.with_name(f"__tmp_{k:04d}__{old.suffix.lower()}")
            try:
                old.rename(tmp); tmps.append((tmp, folder / new))
            except OSError as e:
                self._log_line(f"⚠️  {old.name}: {e}")
        for tmp, new in tmps:
            try:
                tmp.rename(new); ok += 1
                self._log_line(f"  {new.name}")
            except OSError as e:
                self._log_line(f"⚠️  {tmp.name} → {new.name}: {e}")
        for nm in unmatched:
            self._log_line(f"  (bỏ qua, không khớp) {nm}")
        self._log_line(f"✅ Đã đổi {ok}/{len(plan)} ảnh theo tab ASSET ({label}).")
        self.status.configure(text=f"Đổi tên xong: {ok}/{len(plan)} ảnh.")

    def _prompt_targets(self):
        """Danh sách ĐÍCH cho đổi tên theo tab PROMPT, ĐÚNG THỨ TỰ mà COPY SELECTED PROMPT
        đã đưa sang G-Labs: 001, 001a, 002, 002a, 002b, 003…
        Có tích dòng nào thì chỉ lấy các dòng đó (khớp với lô đã copy); không tích thì lấy hết.
        Trả về [(tên_đích, khoá_30_ký_tự_đầu_của_prompt, khoá_CẢ_prompt)].
        Khoá cả prompt dùng để tra ngược qua nhật ký G-Labs (chính xác tuyệt đối)."""
        dt = self.dt_prompts
        rows = self._recompute_prompts(self.prof.get("prompts", []))
        checked = set(dt.checked)
        out, mi = [], 0
        for r in rows:
            iid = f"e{len(out)}" if r.get("_virtual") else f"m{mi}"
            if not r.get("_virtual"):
                mi += 1
            if checked and iid not in checked:
                continue
            p = (r.get("prompt") or "").strip()
            if r.get("id") and p:
                out.append((r["id"], _norm_match(p[:30]), _norm_match(p)))
        return out

    def _rename_all_by_prompt(self):
        """ĐỔI TÊN CHUNG 1 LÔ (ảnh scene + ảnh con) theo tab PROMPT.

        Vì sao dùng SỐ JOB chứ không dùng tên: G-Labs đặt tên = <số job>_<30 ký tự đầu của
        prompt>_s<biến thể>. Prompt ảnh nền đều bắt đầu bằng "[character1] in [nền]," nên MỌI
        scene cùng nền ra tên giống hệt nhau — không phân biệt được. Ngược lại SỐ JOB chính là
        thứ tự prompt trong lô đã dán (job 1 = prompt đầu tiên). Ảnh con thì tên riêng biệt nên
        được dùng để ĐỐI CHIẾU: lệch là báo ngay."""
        folder = Path(_clean_path(self.media_folder.get()))
        if not folder.is_dir():
            return self._warn("Folder ảnh không hợp lệ.\n\n"
                              "Chọn ở ô 'Folder ảnh' TRÊN CÙNG tab MEDIA.")
        if _parse_concept_action is None:
            return self._warn(f"Không nạp được fky_make_draft.py cạnh app ({DRAFT_SCRIPT.parent}).")
        targets = self._prompt_targets()
        if not targets:
            return self._warn("Tab PROMPT chưa có scene nào. Nhập SCENES trước.")
        by_job, done_ids, other = self._scan_job_images(folder)
        done = len(done_ids)
        if not by_job:
            return self._warn(
                f"Không thấy ảnh nào có SỐ JOB ở đầu tên (kiểu 12_character1_in_fred-white_s1.jpg).\n\n"
                f"Đã đúng tên sẵn: {done} ảnh." +
                (f"\nKhông đọc được số: {len(other)} ảnh (vd {other[0]})." if other else ""))
        dup = {j: v for j, v in by_job.items() if len(v) > 1}
        if dup:
            lines = [f"  • job {j}: {len(v)} file ({', '.join(x.name for x in v[:3])}…)"
                     for j, v in sorted(dup.items())[:10]]
            if not messagebox.askyesno(
                    "⚠ CÒN NHIỀU BIẾN THỂ CHO 1 JOB",
                    f"{len(dup)} job còn nhiều hơn 1 ảnh (biến thể _s1.._s4 chưa xoá bớt):\n\n"
                    + "\n".join(lines) +
                    "\n\nMỗi prompt chỉ nên giữ 1 ảnh. Vẫn tiếp tục (lấy file đầu theo tên)?"):
                return

        n_t = len(targets)
        names = [t[0] for t in targets]
        low = [nm.lower() for nm in names]
        have = {s.lower() for s in done_ids}        # ảnh đã đúng tên đang nằm trong folder

        # ── ỨNG JOB VỚI PROMPT ───────────────────────────────────────────────────
        # Thứ tự ưu tiên:
        #   1. Ô 'Lô này bắt đầu từ ảnh số' có chữ  -> ép theo mốc người dùng gõ.
        #   2. NHẬT KÝ G-LABS                       -> tra thẳng tên file gốc ra prompt.
        #   3. Dò mốc bằng đối chiếu prompt         -> đường lùi khi không có nhật ký.
        # Gen làm nhiều đợt thì mỗi đợt G-Labs đánh số job lại từ 1, nên không thể
        # mặc định job 1 = prompt đầu tiên.
        idx_of, off, n_log, n_guess = {}, None, 0, 0
        typed = (self.rn_batch_start.get() or "").strip().lower()
        if typed:
            if typed not in low and typed.isdigit():
                typed = f"{int(typed):03d}"
            if typed not in low:
                return self._warn(
                    f"Không thấy ảnh số '{self.rn_batch_start.get().strip()}' trong lô prompt hiện tại.\n\n"
                    "Gõ đúng số ảnh như ở tab PROMPT (vd 101, hoặc 042a), hoặc xoá trống ô "
                    "'Lô này bắt đầu từ ảnh số' để app tự dò.")
            off = low.index(typed)
            src_note = f"mốc do bạn gõ: job 1 = {names[off]}"
        else:
            idx_of, nfile, gerr = self._map_by_glabs(targets, by_job, folder)
            n_log = len(idx_of)
            if idx_of:
                # Suy mốc từ chính các job đã tra được, để lấp nốt job nhật ký không có.
                offs = collections.Counter(i - (j - 1) for j, i in idx_of.items())
                off = offs.most_common(1)[0][0]
                src_note = (f"nhật ký G-Labs ({nfile} file phiên): tra được {n_log}/{len(by_job)} ảnh")
                if len(offs) > 1:
                    src_note += f" · {len(offs)} mốc khác nhau, lấy mốc phổ biến nhất"
            else:
                off, ok1, ok2, n_use = self._detect_batch_offset(targets, by_job)
                if off is None or not self._offset_is_clear(ok1, ok2, n_use):
                    guess = f"\n\nApp đoán job 1 = {names[off]} ({ok1}/{n_use} job khớp)" if off is not None else ""
                    return self._warn(
                        "Chưa dò chắc được job 1 của đợt này ứng với ảnh số mấy.\n\n"
                        + (gerr + "\n\n" if gerr else "") +
                        "Thường do lô toàn ảnh nền cùng một bối cảnh (tên file giống hệt nhau) nên "
                        "không có gì để đối chiếu." + guess +
                        "\n\nGõ thẳng số ảnh vào ô 'Lô này bắt đầu từ ảnh số' rồi bấm ĐỔI TÊN lại.")
                src_note = f"dò theo prompt (không có nhật ký): job 1 = {names[off]} ({ok1}/{n_use} job khớp)"

        plan, mismatch, over, mapped = [], [], [], []
        used_idx = set(idx_of.values())
        for job in sorted(by_job):
            i = idx_of.get(job)
            if i is None:                                  # nhật ký không có -> suy theo mốc
                i = off + job - 1
                if job < 1 or i >= n_t or i in used_idx:
                    over.append(job)
                    continue
                n_guess += 1
            name, key = targets[i][0], targets[i][1]
            mapped.append((job, name))
            src = by_job[job][0]
            fkey = _img_desc_key(src.name)
            ok = (len(fkey) >= 8 and (fkey.startswith(key[:len(fkey)]) or key.startswith(fkey[:len(key)])))
            if not ok:
                mismatch.append(f"  • job {job} → {name}: tên file '{src.name[:38]}' không khớp prompt")
            plan.append((src, name + src.suffix.lower()))
        plan = [(o, n) for (o, n) in plan if o.name != n]
        if not plan:
            return self._warn("Không ảnh nào cần đổi tên.")
        if over:
            mismatch.append(f"  • {len(over)} job không ứng được prompt nào (vượt lô, hoặc trùng "
                            f"prompt đã dùng): {', '.join(str(x) for x in over[:8])} — bỏ qua")
        # Đợt này định ghi đè lên ảnh của đợt trước -> gần như chắc chắn mốc sai.
        collide = [n for (_j, n) in mapped if n.lower() in have]
        lines = [f"  {o.name}  →  {n}" for o, n in plan[:22]]
        if len(plan) > 22:
            lines.append(f"  … (+{len(plan)-22} ảnh nữa)")
        head = (f"Sẽ đổi {len(plan)} ảnh — {src_note}.\n"
                f"Lô prompt: {n_t} prompt.\n"
                f"Nguồn khớp: tra nhật ký {n_log} ảnh · suy theo mốc {n_guess} ảnh · "
                f"bỏ qua {len(over)} ảnh.\n")
        if mapped:
            head += (f"Khớp: job {mapped[0][0]} → {mapped[0][1]}"
                     + (f"  …  job {mapped[-1][0]} → {mapped[-1][1]}" if len(mapped) > 1 else "") + "\n")
        extra = f"\n\nĐã đúng tên sẵn trong folder: {done} ảnh." if done else ""
        if collide:
            extra += ("\n\n⛔ GHI ĐÈ ẢNH ĐỢT TRƯỚC — mốc gần như chắc chắn SAI:\n  "
                      + ", ".join(collide[:12]) + ("…" if len(collide) > 12 else "")
                      + "\nSửa ô 'Lô này bắt đầu từ ảnh số' rồi thử lại.")
        if mismatch:
            extra += ("\n\n⚠ CẢNH BÁO ĐỐI CHIẾU — có thể lô ảnh KHÔNG cùng thứ tự với lô prompt "
                      "(gen lại lẻ, dán làm nhiều lần, hoặc tích khác lúc copy):\n" + "\n".join(mismatch[:8]))
        if not messagebox.askyesno(
                "ĐỔI TÊN THEO TAB PROMPT?" + (" ⛔" if collide else (" ⚠" if mismatch else "")),
                head + "\n" + "\n".join(lines) + extra +
                "\n\nĐỔI TÊN file thật trên ổ đĩa (khó undo). Tiếp tục?"):
            return
        self._log_line(f"\n▶ Đổi tên theo tab PROMPT ({folder}) — {src_note}")
        tmps, ok_n = [], 0
        for k, (old, new) in enumerate(plan):
            tmp = old.with_name(f"__tmp_pr_{k:04d}__{old.suffix.lower()}")
            try:
                old.rename(tmp); tmps.append((tmp, folder / new))
            except OSError as e:
                self._log_line(f"⚠️  {old.name}: {e}")
        for tmp, new in tmps:
            try:
                if new.exists():
                    new.unlink()
                tmp.rename(new); ok_n += 1
                self._log_line(f"  {new.name}")
            except OSError as e:
                self._log_line(f"⚠️  {tmp.name} → {new.name}: {e}")
        for ln in mismatch:
            self._log_line("⚠️ " + ln.strip())
        self._log_line(f"✅ Đã đổi {ok_n}/{len(plan)} ảnh theo tab PROMPT.")
        self.rn_batch_start.set("")                # dọn ô mốc, đợt sau app dò lại từ đầu
        rng = (f"{mapped[0][1]} → {mapped[-1][1]}" if mapped else "?")
        self.status.configure(
            text=f"Đổi tên xong: {ok_n}/{len(plan)} ảnh ({rng}) — "
                 f"tra nhật ký {n_log}, suy theo mốc {n_guess}.")

    def _preflight_images(self):
        """Point 10: đối chiếu ảnh trong folder với danh sách scene ở tab PROMPT TRƯỚC khi
        build. Báo THIẾU số nào / THỪA số nào / TRÙNG số nào (nhiều file 1 số). Không cần ffmpeg."""
        folder = _clean_path(self.v_images.get())
        if not folder or not Path(folder).is_dir():
            return self._warn("Chưa có 'Folder ảnh' hợp lệ. Chọn folder ảnh scene ở ô TRÊN CÙNG tab MEDIA.")
        prompts = self.prof.get("prompts", [])
        expected = [i + 1 for i, s in enumerate(prompts)
                    if (s.get("vo") or "").strip() or (s.get("char") or "").strip()]
        if not expected:
            return self._warn("Tab PROMPT chưa có scene nào. Nhập SCENES trước.")
        exts = {".png", ".jpg", ".jpeg", ".webp", ".bmp"}
        present, el_present = {}, set()
        for d in (Path(folder), Path(folder) / "elements", Path(folder) / "element"):
            if not d.is_dir():
                continue
            for p in d.iterdir():
                if p.is_file() and p.suffix.lower() in exts:
                    if ELEMENT_STEM_RE.match(p.stem):      # ảnh con 042a
                        el_present.add(p.stem.lower())
                        continue
                    if d != Path(folder):
                        continue
                    m = re.match(r'^(?:scene|img|image|s)?[_\-\s]?(\d+)', p.stem, re.IGNORECASE)
                    if m:
                        present.setdefault(int(m.group(1)), []).append(p.name)
        exp_set, pres_set = set(expected), set(present)
        missing = sorted(exp_set - pres_set)
        extra = sorted(pres_set - exp_set)
        dups = sorted(n for n in present if len(present[n]) > 1)
        el_expected = [eid for (eid, _c, _d, _p, _s) in self._element_prompt_rows()]
        el_missing = [e for e in el_expected if e.lower() not in el_present]
        el_extra = sorted(el_present - {e.lower() for e in el_expected})

        def _fmt(nums):
            return ", ".join(str(n) for n in nums[:25]) + (f" … (+{len(nums) - 25})" if len(nums) > 25 else "")
        ok = not (missing or extra or dups)
        lines = [f"Scene ở tab PROMPT : {len(expected)}  (số 1..{expected[-1]})",
                 f"Ảnh có số hợp lệ    : {len(present)}", ""]
        lines.append("✅ Thiếu: 0" if not missing else f"❌ THIẾU {len(missing)} scene: {_fmt(missing)}")
        lines.append("✅ Thừa: 0" if not extra else f"⚠ THỪA {len(extra)} số (không có scene): {_fmt(extra)}")
        lines.append("✅ Trùng số: 0" if not dups else f"❌ TRÙNG {len(dups)} số (nhiều file/1 số): {_fmt(dups)}")
        if el_expected:
            lines.append("")
            lines.append(f"Ảnh con element     : cần {len(el_expected)}, có {len(el_expected) - len(el_missing)}"
                         + ("" if not el_missing else f"  — chưa có: {_fmt(el_missing)}")
                         + ("" if not el_extra else f"  — thừa: {_fmt(el_extra)}"))
            lines.append("   (thiếu ảnh con KHÔNG chặn: draft chỉ đặt ảnh nền cho mảnh đó)")
        self._log_line(f"\n▶ Kiểm tra ảnh ↔ scene ({folder})")
        for ln in lines:
            if ln:
                self._log_line("   " + ln)
        (messagebox.showinfo if ok else messagebox.showwarning)(
            "ĐỦ ẢNH — SẴN SÀNG BUILD" if ok else "CÓ VẤN ĐỀ VỀ ẢNH", "\n".join(lines))

    def _save_episode(self):
        """Point 11: LƯU TẬP — xuất toàn bộ dữ liệu tập hiện tại ra 1 THƯ MỤC gồm nhiều file
        CSV rời (scenes / scene-list / thumbnails / characters / backgrounds), để lưu trữ và
        dựng lại về sau. scene-list.csv nạp thẳng vào 'File scene' ở phần Dựng video."""
        import csv
        prompts = self.prof.get("prompts", [])
        thumbs = self.prof.get("thumbnails", [])
        if not prompts and not thumbs:
            return self._warn("Chưa có gì để lưu (tab PROMPT và THUMBNAIL đều trống).")
        ep = simpledialog.askstring("LƯU TẬP", "Tên tập (dùng làm tên thư mục):",
                                    parent=self, initialvalue=self.prof.get("name", "episode"))
        if not ep:
            return
        parent = filedialog.askdirectory(title="Chọn nơi chứa thư mục tập", initialdir=str(Path.home()))
        if not parent:
            return
        outdir = Path(parent) / _slug(ep)
        try:
            outdir.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            return self._warn(f"Không tạo được thư mục: {e}")

        def _dump(path, header, rows):
            # utf-8-sig để Excel mở tiếng Việt không lỗi font
            with open(path, "w", newline="", encoding="utf-8-sig") as fh:
                w = csv.writer(fh)
                w.writerow(header)
                w.writerows(rows)

        written = []
        srows = [[r.get("id", ""), r.get("vo", ""), r.get("char", ""), r.get("bg", ""),
                  r.get("action", ""), r.get("camera", ""), r.get("time", ""), r.get("prompt", "")]
                 for r in self._recompute_prompts(prompts)]
        if srows:
            _dump(outdir / "scenes.csv",
                  ["id", "vo", "character", "background", "action", "camera", "time", "prompt"], srows)
            written.append("scenes.csv")
        slrows = [[f"{i+1:03d}", (s.get("vo") or "").strip()]
                  for i, s in enumerate(prompts) if (s.get("vo") or "").strip()]
        if slrows:
            _dump(outdir / "scene-list.csv", ["ID", "VO"], slrows)
            written.append("scene-list.csv")
        erows = [[eid, cell, desc, p] for (eid, cell, desc, p, _s) in self._element_prompt_rows()]
        if erows:
            _dump(outdir / "elements.csv", ["id", "cell", "desc", "prompt"], erows)
            written.append("elements.csv")
        trows = [[r.get("setting", ""), r.get("action", ""), r.get("prompt", "")]
                 for r in self._recompute_thumb(thumbs)]
        if trows:
            _dump(outdir / "thumbnails.csv", ["scene_setting", "scene_action", "prompt"], trows)
            written.append("thumbnails.csv")
        crows = [[r.get("alias", ""), r.get("t_goc", ""), r.get("subject", ""), r.get("ref_prompt", "")]
                 for r in (self._locked_chars() + self._recompute_chars(self.prof.get("characters", [])))]
        if crows:
            _dump(outdir / "characters.csv", ["alias", "ten_goc", "subject", "ref_prompt"], crows)
            written.append("characters.csv")
        brows = [[r.get("t_goc", ""), r.get("subject", ""), r.get("ref_prompt", "")]
                 for r in (self._locked_bg() + self._recompute_bg(self.prof.get("backgrounds", [])))]
        if brows:
            _dump(outdir / "backgrounds.csv", ["ten_goc", "subject", "ref_prompt"], brows)
            written.append("backgrounds.csv")

        self._log_line(f"\n▶ LƯU TẬP → {outdir}")
        for f in written:
            self._log_line("   • " + f)
        self._set_status(f"Đã lưu tập '{ep}' ({len(written)} file CSV).")
        if messagebox.askyesno("ĐÃ LƯU TẬP",
                               f"Đã lưu {len(written)} file CSV vào:\n{outdir}\n\nMở thư mục?"):
            open_in_explorer(str(outdir))

    def _spawn(self, cmd, label, cwd=None):
        self._log_line(f"\n▶ {label}")
        self._log_line("$ " + " ".join(self._q(a) for a in cmd))
        self.status.configure(text=f"Đang chạy: {label}…")
        self.stop_btn.configure(state="normal")
        threading.Thread(target=self._worker, args=(cmd, cwd), daemon=True).start()

    def _worker(self, cmd, cwd):
        try:
            env = os.environ.copy()
            env["PYTHONIOENCODING"] = "utf-8"
            env["PYTHONUTF8"] = "1"
            env["PYTHONUNBUFFERED"] = "1"
            kw = {}
            if IS_WIN:
                kw["creationflags"] = 0x08000000
            self.proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, text=True, encoding="utf-8",
                                         errors="replace", bufsize=1, **kw)
            assert self.proc.stdout is not None
            for line in self.proc.stdout:
                self.msg_q.put(("log", line.rstrip("\n")))
            self.proc.wait()
            self.msg_q.put(("log", f"[Hoàn tất — mã thoát {self.proc.returncode}]"))
        except Exception as e:
            self.msg_q.put(("log", f"[Lỗi chạy] {e}"))
        finally:
            self.proc = None
            self.msg_q.put(("done", None))

    def _stop(self):
        self._tts_cancel = True
        p = self.proc
        if p and p.poll() is None:
            try:
                p.terminate()
                self.msg_q.put(("log", "Đã yêu cầu dừng."))
            except Exception as e:
                self.msg_q.put(("log", f"[Không dừng được] {e}"))
        elif self._tts_busy:
            self.msg_q.put(("log", "Đã yêu cầu dừng tạo giọng nói…"))

    def _drain_queue(self):
        try:
            while True:
                kind, payload = self.msg_q.get_nowait()
                if kind == "log":
                    self._log_line(payload)
                elif kind == "status":
                    self.status.configure(text=payload)
                elif kind == "tts_status":
                    try:
                        txt, col = payload
                        self.tts_status.configure(text=txt, foreground=col)
                    except Exception:
                        pass
                elif kind == "vo_ready":
                    self._vo_tmp_mp3 = payload.get("mp3", "")
                    self._vo_srt_text = payload.get("srt_text", "") or ""
                    self._vo_done = bool(self._vo_tmp_mp3)
                    if payload.get("want_srt") and not self._vo_srt_text:
                        self._set_status("Đã tạo VO. Chưa lấy được phụ đề — vẫn có thể bấm XUẤT SRT để thử lại.")
                    elif self._vo_srt_text:
                        self._set_status("Đã tạo VO (kèm phụ đề). Bấm XUẤT VO / XUẤT SRT để lưu.")
                    else:
                        self._set_status("Đã tạo VO. Bấm XUẤT VO để lưu.")
                    self._update_tts_btn_state()
                elif kind == "done":
                    self.status.configure(text="Xong.")
                    self.stop_btn.configure(state="disabled")
                    self._tts_busy = False
                    self._update_tts_btn_state()
        except queue.Empty:
            pass
        self.after(80, self._drain_queue)

    # ═════════ UTILS ═════════
    def _guard_busy(self):
        if self.proc is not None or self._tts_busy:
            self._warn("Đang có tiến trình chạy. Đợi xong hoặc bấm DỪNG.")
            return False
        return True

    @staticmethod
    def _q(arg):
        return f'"{arg}"' if " " in str(arg) else str(arg)

    def _warn(self, msg):
        messagebox.showwarning("KHOAN ĐÃ", msg)

    def _log_line(self, text):
        self.log.configure(state="normal")
        self.log.insert("end", text + "\n")
        self.log.see("end")
        self.log.configure(state="disabled")

    def _clear_log(self):
        self.log.configure(state="normal")
        self.log.delete("1.0", "end")
        self.log.configure(state="disabled")

    def _on_close(self):
        busy = (self.proc is not None and self.proc.poll() is None) or self._tts_busy
        if busy:
            if not messagebox.askyesno("THOÁT?", "Đang chạy 1 tiến trình (build/tạo giọng nói). Thoát luôn?"):
                return
            self._tts_cancel = True
            try:
                if self.proc is not None:
                    self.proc.terminate()
            except Exception:
                pass
        try:
            self._flush_save()
        except Exception:
            pass
        self.destroy()


