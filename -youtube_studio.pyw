    @staticmethod
    def _draw_line(g, x0, y0, x1, y1, color, th=2):
        dx = abs(x1 - x0); dy = abs(y1 - y0)
        sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
        err = dx - dy
        while True:
            for ax in range(th):
                for ay in range(th):
                    X, Y = x0 + ax, y0 + ay
                    if 0 <= Y < len(g) and 0 <= X < len(g[0]):
                        g[Y][X] = color
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 > -dy:
                err -= dy; x0 += sx
            if e2 < dx:
                err += dx; y0 += sy

    def _make_check_images(self):
        n = 18; border = "#9aa0a6"; mark = "#1b98e0"; fill = "#ffffff"

        def make(checked):
            g = [[fill] * n for _ in range(n)]
            for i in range(n):
                for j in range(n):
                    if i < 2 or i >= n - 2 or j < 2 or j >= n - 2:
                        g[i][j] = border
            if checked:
                self._draw_line(g, 4, 9, 8, 13, mark)
                self._draw_line(g, 8, 13, 14, 4, mark)
            img = tk.PhotoImage(width=n, height=n)
            img.put(" ".join("{" + " ".join(row) + "}" for row in g))
            return img
        self.img_uncheck = make(False)
        self.img_check = make(True)
        # Ảnh trong suốt cho dòng KHOÁ (không hiện checkbox).
        self.img_blank = tk.PhotoImage(width=n, height=n)

