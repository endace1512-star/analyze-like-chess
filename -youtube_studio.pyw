    def _add_protagonist(self):
        if not self.cfg_editing:       # chỉ thêm được khi đang CHỈNH SỬA
            return
        self._sync_style_from_widgets()
        self.prof.setdefault("protagonists", []).append(
            {"name": "", "charStyle": "", "bg_name": "", "bgStyle": "",
             "conceptStyle": "", "conceptSoloStyle": "", "metaphorStyle": "",
             "use_concept": False})
        self._rebuild_protagonists()   # dựng lại + giữ trạng thái mở (chưa áp dụng tới khi LƯU)

    def _del_protagonist(self, idx):
        if not self.cfg_editing:
            return
        self._sync_style_from_widgets()
        try:
            nm = self.prof["protagonists"][idx].get("name") or f"#{idx+1}"
        except (KeyError, IndexError):
            return
        if not messagebox.askyesno("XÁC NHẬN XOÁ", f"Xoá protagonist '{nm}'?"):
            self._rebuild_protagonists()
            return
        del self.prof["protagonists"][idx]
        self._rebuild_protagonists()

    def _sync_style_from_widgets(self):
        for key, w in getattr(self, "style_widgets", {}).items():
            self.prof["style"][key] = w.get("1.0", "end").rstrip("\n")
        if getattr(self, "font_path_var", None) is not None:
            self.prof["font_path"] = _clean_path(self.font_path_var.get())
        if getattr(self, "pose_dir_var", None) is not None:
            self.prof["pose_dir"] = _clean_path(self.pose_dir_var.get())
        if getattr(self, "glabs_dir_var", None) is not None:
            self.prof["glabs_dir"] = _clean_path(self.glabs_dir_var.get())
        if getattr(self, "prot_widgets", None) is not None:
            self.prof["protagonists"] = [{
                "name": pw["name"].get().strip(),
                "charStyle": pw["charStyle"].get("1.0", "end").rstrip("\n"),
                "bg_name": pw["bg_name"].get().strip(),
                "bgStyle": pw["bgStyle"].get("1.0", "end").rstrip("\n"),
                "conceptStyle": pw["conceptStyle"].get("1.0", "end").rstrip("\n") if "conceptStyle" in pw else "",
                "conceptSoloStyle": pw["conceptSoloStyle"].get("1.0", "end").rstrip("\n") if "conceptSoloStyle" in pw else "",
                "metaphorStyle": pw["metaphorStyle"].get("1.0", "end").rstrip("\n") if "metaphorStyle" in pw else "",
                "use_concept": bool(pw["use_concept"].get()) if "use_concept" in pw else False,
            } for pw in self.prot_widgets]

    def _load_style_into_widgets(self):
        # Tạm mở để (ghi lại) nội dung, sau đó _rebuild_protagonists() -> _apply_cfg_lock_state()
        # sẽ khoá/mở theo trạng thái cfg_editing.
        for key, w in self.style_widgets.items():
            w.configure(state="normal")
            w.delete("1.0", "end")
            w.insert("1.0", self.prof["style"].get(key, "") or "")
        if getattr(self, "font_path_var", None) is not None:
            self.font_path_var.set(self.prof.get("font_path", "") or "")
        if getattr(self, "pose_dir_var", None) is not None:
            self.pose_dir_var.set(self.prof.get("pose_dir", "") or "")
        if getattr(self, "glabs_dir_var", None) is not None:
            self.glabs_dir_var.set(self.prof.get("glabs_dir", "") or "")
        self._rebuild_protagonists()

    # ═════════ CHANNEL CONFIG: KHOÁ / CHỈNH SỬA / LƯU ═════════
    def _now_stamp(self):
        return time.strftime("%H:%M · %d/%m/%Y")

    def _cfg_update_saved_label(self):
        if not hasattr(self, "cfg_saved_lbl"):
            return
        ts = (self.prof.get("style_saved_at") or "").strip()
        if self.cfg_editing:
            self.cfg_saved_lbl.configure(text="● ĐANG CHỈNH SỬA — nhớ bấm LƯU")
        elif ts:
            self.cfg_saved_lbl.configure(text=f"ĐÃ LƯU LẦN CUỐI: {ts}")
        else:
            self.cfg_saved_lbl.configure(text="CHƯA LƯU LẦN NÀO")

    def _apply_cfg_lock_state(self):
        """Khoá/mở toàn bộ ô + nút của tab Channel Config theo self.cfg_editing, và
        cập nhật nhãn thời gian + nút CHỈNH SỬA/LƯU/HUỶ."""
        editing = self.cfg_editing
        txt_state = "normal" if editing else "disabled"
        txt_bg = "white" if editing else CLR_LOCK_BG
        ent_state = "normal" if editing else "readonly"
        btn_state = "normal" if editing else "disabled"
        for w in getattr(self, "style_widgets", {}).values():
            try:
                w.configure(state=txt_state, background=txt_bg)
            except Exception:
                pass
        for pw in getattr(self, "prot_widgets", []) or []:
            for k in ("charStyle", "bgStyle", "conceptStyle", "conceptSoloStyle", "metaphorStyle"):
                try:
                    pw[k].configure(state=txt_state, background=txt_bg)
                except Exception:
                    pass
            for k in ("name_entry", "bgn_entry"):
                try:
                    pw[k].configure(state=ent_state)
                except Exception:
                    pass
            for k in ("concept_chk", "del_btn"):
                try:
                    pw[k].configure(state=btn_state)
                except Exception:
                    pass
        if getattr(self, "prot_add_btn", None) is not None:
            self.prot_add_btn.configure(state=btn_state)
        for _w, _st in ((getattr(self, "font_entry", None), ent_state),
                        (getattr(self, "font_btn", None), btn_state),
                        (getattr(self, "pose_entry", None), ent_state),
                        (getattr(self, "pose_btn", None), btn_state),
                        (getattr(self, "glabs_entry", None), ent_state),
                        (getattr(self, "glabs_btn", None), btn_state)):
            if _w is not None:
                try:
                    _w.configure(state=_st)
                except Exception:
                    pass
        # thanh nút trên cùng
        if hasattr(self, "cfg_edit_btn"):
            if editing:
                self.cfg_edit_btn.pack_forget()
                self.cfg_save_btn.pack(side="left")
                self.cfg_cancel_btn.pack(side="left", padx=(6, 0))
            else:
                self.cfg_save_btn.pack_forget()
                self.cfg_cancel_btn.pack_forget()
                self.cfg_edit_btn.pack(side="left")
        self._cfg_update_saved_label()

    def _cfg_enter_edit(self):
        if self.cfg_editing:
            return
        # snapshot để HUỶ khôi phục (kể cả thêm/xoá protagonist giữa chừng)
        self._cfg_backup = {
            "style": copy.deepcopy(self.prof.get("style", {})),
            "protagonists": copy.deepcopy(self.prof.get("protagonists", [])),
            "style_saved_at": self.prof.get("style_saved_at", ""),
            "font_path": self.prof.get("font_path", ""),
            "pose_dir": self.prof.get("pose_dir", ""),
            "glabs_dir": self.prof.get("glabs_dir", ""),
        }
        self.cfg_editing = True
        self._apply_cfg_lock_state()
        try:
            w = self.style_widgets.get("sceneStyle")
            if w:
                w.focus_set()
        except Exception:
            pass
        self._set_status("Đang chỉnh sửa Channel Config — bấm LƯU để áp dụng, HUỶ để bỏ. "
                         "(Ctrl+Z / Ctrl+Y hoạt động trong từng ô)")

    def _cfg_save(self):
        if not self.cfg_editing:
            return
        self._sync_style_from_widgets()             # widget -> model
        self.prof["style_saved_at"] = self._now_stamp()
        self._cfg_backup = None
        self.cfg_editing = False
        try:
            save_profile(self.prof)
            save_last_profile(self.prof["name"])
        except Exception as e:
            self._set_status(f"Lỗi lưu: {e}")
        self._load_style_into_widgets()             # nạp lại từ model + khoá
        self.refresh_data_tabs()                    # ÁP DỤNG style/alias cho PROMPT/THUMBNAIL/ASSET
        self._set_status(f"Đã lưu Channel Config lúc {self.prof['style_saved_at']} — đã áp dụng toàn app.")

    def _cfg_cancel(self):
        if not self.cfg_editing:
            return
        b = getattr(self, "_cfg_backup", None)
        if b is not None:                           # khôi phục nguyên trạng trước khi sửa
            self.prof["style"] = b["style"]
            self.prof["protagonists"] = b["protagonists"]
            self.prof["style_saved_at"] = b.get("style_saved_at", "")
            self.prof["font_path"] = b.get("font_path", "")
            self.prof["pose_dir"] = b.get("pose_dir", "")
            self.prof["glabs_dir"] = b.get("glabs_dir", "")
        self._cfg_backup = None
        self.cfg_editing = False
        self._load_style_into_widgets()             # nạp lại từ model đã khôi phục + khoá
        try:
            save_profile(self.prof)
        except Exception:
            pass
        self.refresh_data_tabs()
        self._set_status("Đã huỷ chỉnh sửa Channel Config (khôi phục nguyên trạng).")

    def _cfg_leave_if_editing(self):
        """Trước khi đổi/tạo/xoá hồ sơ: nếu đang sửa thì HUỶ (khôi phục) để không dây ra hồ sơ."""
        if self.cfg_editing:
            self._cfg_cancel()

