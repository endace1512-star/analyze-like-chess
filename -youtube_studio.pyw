        cols = [
            # 25/09/2026: thumbnail kiểu nền trắng + chữ to -> cột 1 là HEADLINE, cột 2 là Fred + đồ vật
            # (vẫn điền vào {{SCENE}} / {{SCENE_ACTION}} của ô THUMBSTYLE như cũ)
