def _clean_path(s):
    """Chuẩn hoá đường dẫn người dùng nhập/dán:
    - bỏ khoảng trắng đầu/cuối;
    - bỏ dấu ngoặc kép/đơn bao NGOÀI (Windows 'Copy as path' luôn kèm "..." → is_dir() báo sai);
    - mở rộng ~ và biến môi trường (%VAR% / $VAR)."""
    s = (s or "").strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ('"', "'"):
        s = s[1:-1].strip()
    if s:
        try:
            s = os.path.expanduser(os.path.expandvars(s))
        except Exception:
            pass
    return s


