    def _open_stock_images(self):
        """Cửa sổ TÌM ẢNH MIỄN PHÍ: danh sách mọi ảnh scene + ảnh phụ của tab PROMPT."""
        folder = _clean_path(self.media_folder.get())
        if not folder or not os.path.isdir(folder):
            return self._warn("Chọn FOLDER ẢNH trước (ô trên cùng tab MEDIA).")
        try:
            import fky_stock_images
        except Exception as e:
            return self._warn(f"Không nạp được fky_stock_images.py cạnh app "
                              f"({DRAFT_SCRIPT.parent}).\n\n{e}")
        targets = []
        for r in self._recompute_prompts(self.prof.get("prompts", [])):
            if not r.get("id"):
                continue
            if r.get("_virtual"):
                targets.append({"id": r["id"], "kind": "piece", "text": r.get("action", "")})
            else:
                targets.append({"id": r["id"], "kind": "scene", "text": r.get("action", ""),
                                "vo": r.get("vo", "")})
        if not targets:
            return self._warn("Tab PROMPT chưa có dòng nào.")
        fky_stock_images.StockWindow(self, targets, folder)

