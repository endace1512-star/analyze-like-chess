                   command=self._import_thumbnail).pack(side="left", padx=(16, 0))

    def _recompute_thumb(self, model):
        cm = self._char_map()
        thumb_style = self.prof["style"].get("thumbStyle", "") or ""
        out = []
        for t in model:
            setting = t.get("setting", "") or ""
            action = t.get("action", "") or ""
            raw = thumb_style.replace("{{SCENE}}", setting).replace("{{SCENE_ACTION}}", action) if setting.strip() else ""
            prompt = render_one(_one_line(_tidy_dots(raw)), cm) if raw else ""
            out.append({"id": t.get("id", ""), "setting": setting, "action": action,
                        "prompt": prompt})
        return out

