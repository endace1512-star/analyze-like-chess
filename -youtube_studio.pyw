    def _char_map(self):
        cm = []
        idx = 1
        for p in self.prof.get("protagonists", []):
            nm = (p.get("name") or "").strip()
            if nm:
                cm.append((f"character{idx}", nm))
            idx += 1
        for c in self.prof.get("characters", []):
            nm = (c.get("t_goc") or "").strip()
            if nm:
                cm.append((f"character{idx}", nm))
            idx += 1
        return cm

