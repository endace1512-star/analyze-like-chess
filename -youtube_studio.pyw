# nếu không thì vật bị vẽ hai lần. PHẢI khớp với danh sách trong fky_make_draft.py.
ELEMENT_FN = ("present", "list")              # demonstrate / undergo / solo giữ 1 ảnh trọn vẹn


def build_element_prompt(desc, cell, element_style):
    """Ráp prompt 1 ảnh con element. Mô tả vật ĐỨNG ĐẦU để tên file G-Labs sinh ra
    (30 ký tự đầu của prompt) phân biệt được từng mảnh -> 'Đổi tên ELEMENT' khớp lại được."""
    d = _one_line(desc).strip(" ,.")
    if not d:
        return ""
    zone = CELL_ZONE.get(int(cell) if str(cell).isdigit() else 0, "centre")
    st = _one_line(element_style or "")
    return _one_line(_tidy_dots(f"{d[0].upper() + d[1:]}, placed in the {zone} zone of a 16:9 "
                                f"frame on an otherwise empty white background. {st}")).strip()


def build_pov_prompt(char, desc, pov_style):
    """02/10/2026: prompt ảnh POV = "[nhân vật đầu cột Character] <nội dung màn hình>. <POV STYLE>".
    Token nhân vật đứng đầu để G-Labs gắn đúng ref (fred / fred-jacket…)."""
    d = _one_line(desc).strip(" ,.")
    if not d:
        return ""
    name = next((n.strip() for n in (char or "").split(",") if n.strip()), "fred")
    st = _one_line(pov_style or "")
    return _one_line(_tidy_dots(f"[{name}] {d}. {st}")).strip()


def concept_elements(idx, action, element_style, char="", pov_style=""):
    """Danh sách ảnh con của 1 beat CONCEPT (idx = số thứ tự scene, từ 1).
    Trả về (fn, [ {id, cell, desc, prompt}, … ]). Không có mảnh / loại beat không tách -> [].
    02/10/2026: mảnh {pov} -> prompt ảnh POV (build_pov_prompt, ô POV STYLE)."""
    if _parse_concept_action is None:
        return "present", []
    try:
        fn, _pose, pieces = _parse_concept_action(action or "")
    except Exception:
        return "present", []
    if fn not in ELEMENT_FN:
        return fn, []
    out = []
    for k, (desc, cell) in enumerate(pieces[:26]):
        if int(cell or 0) == POV_CELL:
            p = build_pov_prompt(char, desc, pov_style)
        else:
            p = build_element_prompt(desc, cell, element_style)
        if p:
            out.append({"id": f"{idx:03d}{chr(ord('a') + k)}", "cell": int(cell) or 5,
                        "desc": desc, "prompt": p})
    return fn, out


def cell_label(cell):
    """Nhãn ô để hiện trên bảng: 'POV' cho ảnh POV, còn lại là số ô."""
    return "POV" if int(cell or 0) == POV_CELL else str(cell)


def render_prompts(sources, char_map):
    """[tên_gốc] -> [alias] theo nguyên token có ngoặc (token-fix)."""
    mappings = []
    for alias, ten_goc in char_map:
        if alias and ten_goc:
            mappings.append(("[" + str(ten_goc) + "]", "[" + str(alias) + "]"))
    mappings.sort(key=lambda p: len(p[0]), reverse=True)
    out = []
    for text in sources:
        if not text:
            out.append(""); continue
        result = str(text)
        for frm, to in mappings:
            result = result.replace(frm, to)
        out.append(result)
    return out


def render_one(text, char_map):
    return render_prompts([text], char_map)[0]


def clean_vo(input_text):
    if isinstance(input_text, (list, tuple)):
        rows = []
        for r in input_text:
            if isinstance(r, (list, tuple)):
                rows.append("\n".join("" if c is None else str(c) for c in r))
            else:
                rows.append("" if r is None else str(r))
        text = "\n".join(rows)
    else:
        text = "" if input_text is None else str(input_text)
    t = text
    t = re.sub(r'^[ \t]*#\s.*$', '', t, flags=re.M)
    t = re.sub(r'^[ \t]*#{2,}.*$', '', t, flags=re.M)
    t = re.sub(r'^[ \t]*\*\*.*?:\*\*.*$', '', t, flags=re.M)
    t = re.sub(r'^[ \t]*[-*+\u2022]\s*\[[x ]\].*$', '', t, flags=re.M)
    t = re.sub(r'^[ \t]*-{3,}[ \t]*$', '', t, flags=re.M)
    t = re.sub(r'\[[^\]]*\]', '', t)
    t = re.sub(r'\([^)]*\)', '', t)
    t = re.sub(r'\{[^}]*\}', '', t)
    t = re.sub(r'\*+', '', t)
    t = t.replace('//', '')
    t = re.sub(r'[|#]', '', t)
    t = re.sub(r'[\u201C\u201D\u201E\u00AB\u00BB"]', '', t)
    t = re.sub(r'[\u2018\u2019]', "'", t)
    t = t.replace('\u2026', ',')
    t = t.replace('...', ',')
    t = re.sub(r'\s*[\u2014\u2013]\s*', ', ', t)
    t = re.sub(r'\s*[;:]\s*', ', ', t)
    lines = [l.strip() for l in t.split('\n')]
    lines = [l for l in lines if l]
    t = ' '.join(lines)
    t = re.sub(r'\s+', ' ', t)
    t = re.sub(r'\s+([,.?!])', r'\1', t)
    t = re.sub(r'([,.])[,.]+', r'\1', t)
    t = re.sub(r'([?!])\s*,', r'\1 ', t)
    t = re.sub(r',\s*\.', '.', t)
    t = re.sub(r'\.\s*,', '.', t)
    t = re.sub(r'([,.?!])(?=\S)', r'\1 ', t)
    t = re.sub(r'\s+', ' ', t).strip()
    t = re.sub(r'^[\s,.]+', '', t)
    if t and t[-1] not in '.?!':
        t = re.sub(r'[,\s]+$', '', t) + '.'
    return t


def _section(text, header):
    m = re.search(r'===\s*' + re.escape(header) + r'\s*===([\s\S]*?)(?:===|$)', text, re.I)
    return m.group(1).strip() if m else ""


def _strip_fence(s):
    s = re.sub(r'```[a-z]*\n?', '', s, flags=re.I)
    s = s.replace('```', '')
    return s.strip()


def _name_lines(section):
    return [l.strip() for l in section.split('\n') if re.match(r'^[a-z][a-z0-9-]*$', l.strip())]


def _tab_lines(section):
    out = []
    for l in _strip_fence(section).split('\n'):
        l = l.rstrip('\r')
        if '\t' in l:
            i = l.index('\t')
            name, subj = l[:i].strip(), l[i + 1:].strip()
            if name:
                out.append((name, subj))
    return out


def parse_charbg(text):
    return _name_lines(_section(text, 'CHARACTERS')), _name_lines(_section(text, 'BACKGROUNDS'))


def parse_scenes(text):
    raw = _section(text, 'SCENES') or text
    raw = _strip_fence(raw)
    grid = []
    for l in raw.split('\n'):
        l = l.rstrip('\r')
        if l.strip() == '':
            continue
        r = l.split('\t')[:6]
        while len(r) < 6:
            r.append('')
        grid.append([c.strip() for c in r])
    return grid


def parse_subjects(text):
    return _tab_lines(_section(text, 'CHARACTER SUBJECTS')), _tab_lines(_section(text, 'BACKGROUND SUBJECTS'))


def parse_thumbnail(text):
    rows = []
    for l in _strip_fence(text).split('\n'):
        l = l.rstrip('\r')
        if l.count('\t') == 2:
            cells = [c.strip() for c in l.split('\t')]
            rows.append((cells[1], cells[2]))
        elif l.count('\t') == 1:
            cells = [c.strip() for c in l.split('\t')]
            rows.append((cells[0], cells[1]))
    return rows


def parse_plain_names(text):
    """Danh sách tên thuần (mỗi dòng 1 tên hợp lệ) — cho import không có header."""
    return [l.strip() for l in _strip_fence(text).split('\n') if re.match(r'^[a-z][a-z0-9-]*$', l.strip())]


