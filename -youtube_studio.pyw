    def _recompute_prompts(self, model):
        cm = self._char_map()
        scene_style = self.prof["style"].get("sceneStyle", "") or ""
        # Nền CONCEPT: bg_name của protagonist có tick "dùng concept" -> scene ở nền này
        # dùng conceptStyle THAY sceneStyle + bỏ ánh sáng day/night. Map bg_name -> conceptStyle.
        concept_bgs, concept_solo_bgs, metaphor_bgs = {}, {}, {}
        for p in self.prof.get("protagonists", []):
            nm = (p.get("bg_name") or "").strip().lower()
            if p.get("use_concept") and nm:
                concept_bgs[nm] = p.get("conceptStyle", "") or ""
                # ô riêng cho beat present/list; trống -> build_prompt_row tự lùi về conceptStyle
                concept_solo_bgs[nm] = p.get("conceptSoloStyle", "") or ""
                metaphor_bgs[nm] = p.get("metaphorStyle", "") or ""     # beat [FN: metaphor]
        el_style = self.prof["style"].get("elementStyle", "") or ""
        pov_style = self.prof["style"].get("povStyle", "") or ""
        out = []
        for i, s in enumerate(model):
            # 1 cột PROMPT: vừa ráp prompt (combine) vừa đổi [tên_gốc] -> [alias] theo
            # tab Character; token nào không khớp alias thì GIỮ NGUYÊN tên gốc.
            _bgk = (s.get("bg", "") or "").strip().lower()
            cstyle = concept_bgs.get(_bgk)                    # None nếu không phải concept
            raw = build_prompt_row(s.get("char", ""), s.get("bg", ""), s.get("action", ""),
                                   s.get("camera", ""), s.get("time", ""), scene_style,
                                   concept_style=cstyle,
                                   concept_solo_style=concept_solo_bgs.get(_bgk),
                                   metaphor_style=metaphor_bgs.get(_bgk),
                                   day_light=self.prof["style"].get("dayLight", ""),
                                   night_light=self.prof["style"].get("nightLight", ""))
            prompt = render_one(raw, cm)
            sid = f"{i+1:03d}" if (s.get("char", "") or s.get("vo", "")) else ""
            # Đợt 2: beat CONCEPT (present/list/undergo) -> danh sách ảnh con 042a, 042b…
            elements, fn = [], ""
            pose = pose_name_of(s.get("action", ""))
            # Cảnh đời thường có {cell N} (SCENE PIECES) cũng sinh ảnh con, y như concept present.
            # [FN: present pose:…] vẫn sinh ảnh con; chỉ ảnh nền lấy từ thư viện
            if sid and (not pose or pose_has_pieces(s.get("action", ""))) and \
                    (cstyle is not None or has_scene_pieces(s.get("action", ""))):
                fn, elements = concept_elements(i + 1, s.get("action", ""), el_style,
                                                char=s.get("char", ""), pov_style=pov_style)
                for e in elements:                        # ảnh POV có token [fred] -> đổi alias
                    e["prompt"] = render_one(e["prompt"], cm)
            el_txt = ""
            if pose and elements:                         # nền thư viện + ảnh con gen mới
                el_txt = f"POSE {pose} + {fn}: " + " ".join(
                    f"{e['id'][-1]}→ô{cell_label(e['cell'])}" for e in elements)
            elif pose:                                    # beat câu nối: ảnh lấy từ thư viện
                el_txt = f"POSE: {pose}"
            elif elements:
                el_txt = f"{fn}: " + " ".join(f"{e['id'][-1]}→ô{cell_label(e['cell'])}"
                                              for e in elements)
            elif cstyle is not None and fn and fn not in ELEMENT_FN:
                el_txt = f"{fn} (1 ảnh)"
            out.append({"id": sid, "vo": s.get("vo", ""), "char": s.get("char", ""),
                        "bg": s.get("bg", ""), "action": s.get("action", ""),
                        "camera": s.get("camera", ""), "time": s.get("time", ""),
                        "elements_txt": el_txt, "elements": elements, "prompt": prompt})
            # Dòng ẢNH CON hiện ngay dưới scene gốc: ID 001a, 001b… (không sửa được, tích để copy)
            for e in elements:
                mark = "{pov}" if e["cell"] == POV_CELL else f"{{cell {e['cell']}}}"
                out.append({"_virtual": True, "_eid": e["id"], "id": e["id"], "vo": "",
                            "char": "", "bg": "", "action": f"{e['desc']} {mark}",
                            "camera": "", "time": "", "elements_txt": f"ô {cell_label(e['cell'])}",
                            "elements": [], "prompt": e["prompt"]})
        return out

    def _element_prompt_rows(self, only_checked=False):
        """Mọi ảnh con element của tab PROMPT: [(id, cell, desc, prompt, scene_idx)].
        only_checked=True -> chỉ các scene đang tích ở tab PROMPT."""
        rows = self._recompute_prompts(self.prof.get("prompts", []))
        checked_m, checked_e = set(), set()
        if only_checked:
            dt = self.dt_prompts
            for iid in dt.checked:
                if iid.startswith("m"):
                    checked_m.add(int(iid[1:]))
                elif iid.startswith("e"):            # tích thẳng dòng ảnh con
                    try:
                        checked_e.add(dt._display[dt.tree.index(iid)].get("_eid"))
                    except Exception:
                        pass
        out, mi = [], 0
        for r in rows:
            if r.get("_virtual"):
                continue
            idx = mi
            mi += 1
            for e in r.get("elements") or []:
                if only_checked and not (idx in checked_m or e["id"] in checked_e):
                    continue
                out.append((e["id"], e["cell"], e["desc"], e["prompt"], idx + 1))
        return out

    def _copy_element_prompts(self):
        """Copy prompt ảnh con (element) của các scene đã tích — mỗi dòng 1 prompt, theo thứ tự
        042a, 042b… Chưa tích gì -> hỏi có lấy TẤT CẢ không."""
        if _parse_concept_action is None:
            return self._warn(f"Không nạp được fky_make_draft.py cạnh app ({DRAFT_SCRIPT.parent}).\n"
                              "Cần file này để đọc mảnh element.")
        sel = self._element_prompt_rows(only_checked=True)
        if not sel:
            if not self.dt_prompts.checked:
                if not messagebox.askyesno("CHƯA CHỌN SCENE",
                                           "Chưa tích scene nào. Copy prompt ảnh con của TẤT CẢ scene?"):
                    return
                sel = self._element_prompt_rows(only_checked=False)
            if not sel:
                return self._warn("Không có ảnh con nào.\n\nChỉ beat CONCEPT (nền fred-white) loại "
                                  "present / list / undergo có mảnh (action có {cell N} hoặc (left)/(right)…) "
                                  "mới sinh prompt ảnh con.")
        self.clipboard_clear()
        self.clipboard_append("\n".join(p for (_i, _c, _d, p, _s) in sel))
        ids = [i for (i, _c, _d, _p, _s) in sel]
        self._set_status(f"Đã copy {len(sel)} prompt ảnh con element ({ids[0]} … {ids[-1]}). "
                         "Dán vào G-Labs thành 1 lô riêng.")
        self._log_line(f"\n▶ Copy {len(sel)} prompt ảnh con element: {', '.join(ids[:20])}"
                       f"{'…' if len(ids) > 20 else ''}")

    def _copy_all_scene_prompts(self):
        """Copy prompt ẢNH NỀN của MỌI scene (không cần tích), đúng thứ tự 001, 002…
        Dòng dùng ảnh thư viện tư thế có prompt rỗng -> tự bỏ qua (khớp số job G-Labs)."""
        rows = self._recompute_prompts(self.prof.get("prompts", []))
        sel = [(r["id"], r["prompt"].strip()) for r in rows
               if not r.get("_virtual") and r.get("id") and (r.get("prompt") or "").strip()]
        if not sel:
            return self._warn("Tab PROMPT chưa có prompt ảnh scene nào.")
        self.clipboard_clear()
        self.clipboard_append("\n".join(p for (_i, p) in sel))
        n_pose = sum(1 for r in rows if not r.get("_virtual") and r.get("id")
                     and not (r.get("prompt") or "").strip())
        self._set_status(f"Đã copy {len(sel)} prompt ảnh scene ({sel[0][0]} … {sel[-1][0]})"
                         + (f", bỏ qua {n_pose} dòng ảnh tư thế" if n_pose else "")
                         + ". Dán vào G-Labs thành 1 lô.")
        self._log_line(f"\n▶ Copy {len(sel)} prompt ảnh scene ({sel[0][0]} … {sel[-1][0]})"
                       + (f", bỏ qua {n_pose} dòng ảnh tư thế" if n_pose else ""))

    def _copy_all_element_prompts(self):
        """Copy prompt ẢNH PHỤ của MỌI scene (không cần tích), đúng thứ tự 001a, 001b, 002a…"""
        if _parse_concept_action is None:
            return self._warn(f"Không nạp được fky_make_draft.py cạnh app ({DRAFT_SCRIPT.parent}).\n"
                              "Cần file này để đọc mảnh ảnh phụ.")
        sel = self._element_prompt_rows(only_checked=False)
        if not sel:
            return self._warn("Tab PROMPT không có ảnh phụ nào.")
        self.clipboard_clear()
        self.clipboard_append("\n".join(p for (_i, _c, _d, p, _s) in sel))
        ids = [i for (i, _c, _d, _p, _s) in sel]
        self._set_status(f"Đã copy {len(sel)} prompt ảnh phụ ({ids[0]} … {ids[-1]}). "
                         "Dán vào G-Labs thành 1 lô riêng.")
        self._log_line(f"\n▶ Copy {len(sel)} prompt ảnh phụ ({ids[0]} … {ids[-1]})")

