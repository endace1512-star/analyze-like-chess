        self.vo_out_path.trace_add("write", lambda *_: self._update_tts_btn_state())

        for var in (self.vo_voice, self.vo_model, self.vo_speed, self.vo_pitch, self.vo_volume, self.vo_lang):
            var.trace_add("write", lambda *a: self._vo_dirty())

    def _update_tts_btn_state(self):
        """TẠO VO bật khi đã chọn thư mục lưu (và không đang chạy). XUẤT VO / XUẤT SRT bật
        khi TẠO VO đã 'done' (và không đang chạy)."""
        if not hasattr(self, "tts_btn"):
            return
        busy = getattr(self, "_tts_busy", False)
        has_out = bool(self.vo_out_path.get().strip())
        done = getattr(self, "_vo_done", False)
        self.tts_btn.configure(state="normal" if (has_out and not busy) else "disabled")
        exp = "normal" if (done and not busy) else "disabled"
        if hasattr(self, "export_vo_btn"):
            self.export_vo_btn.configure(state=exp)
        if hasattr(self, "export_srt_btn"):
            self.export_srt_btn.configure(state=exp)

    def _pick_vo_out_path(self):
        p = filedialog.askdirectory(title="Chọn THƯ MỤC lưu VO.mp3 + sub.srt")
        if p:
            self.vo_out_path.set(p)

    def _vo_mode(self):
        return "file" if "file" in self.vo_src_label.get().lower() else "data"

    def _on_vo_src_change(self):
        if self._vo_mode() == "file":
            self.vo_in.pack_forget()
            self.vo_filerow.pack(fill="x")
        else:
            self.vo_filerow.pack_forget()
            self.vo_in.pack(fill="both", expand=True)

    def _pick_vo_file(self):
        p = filedialog.askopenfilename(title="Chọn file script",
                                       filetypes=[("Văn bản", "*.txt *.md *.srt"), ("Tất cả", "*.*")])
        if p:
            self.vo_file.set(p)
            self._sync_vo_and_save()

    def _get_script_text(self):
        if self._vo_mode() == "file":
            p = self.vo_file.get().strip()
            if not p or not Path(p).is_file():
                messagebox.showwarning("THIẾU FILE", "Chọn file script (.txt/.md/.srt) trước.")
                return ""
            try:
                return Path(p).read_text(encoding="utf-8", errors="replace")
            except Exception as e:
                messagebox.showwarning("LỖI ĐỌC FILE", str(e))
                return ""
        return self.vo_in.get("1.0", "end")

    def _vo_clean(self):
        res = clean_vo(self._get_script_text())
        self.vo_out.delete("1.0", "end")
        self.vo_out.insert("1.0", res)
        self.vo_out.focus_set()
        self.vo_out.tag_add("sel", "1.0", "end")
        self._sync_vo_and_save()

    def _vo_copy(self):
        res = self.vo_out.get("1.0", "end").strip()
        if not res:
            return messagebox.showinfo("TRỐNG", "Chưa có VO. Bấm XUẤT VO 1 ĐOẠN trước.")
        self.clipboard_clear()
        self.clipboard_append(res)
        self._set_status("Đã copy VO.")

    def _sync_vo_from_widgets(self):
        if hasattr(self, "vo_in"):
            self.prof["vo_script"] = self.vo_in.get("1.0", "end").rstrip("\n")
            self.prof["vo_clean"] = self.vo_out.get("1.0", "end").rstrip("\n")
            self.prof["vo_src_mode"] = self._vo_mode()
            self.prof["vo_file"] = self.vo_file.get().strip()

    def _load_vo_into_widgets(self):
        if hasattr(self, "vo_in"):
            self.vo_in.delete("1.0", "end")
            self.vo_in.insert("1.0", self.prof.get("vo_script", "") or "")
            self.vo_out.delete("1.0", "end")
            self.vo_out.insert("1.0", self.prof.get("vo_clean", "") or "")
            self.vo_file.set(self.prof.get("vo_file", "") or "")
            self.vo_src_label.set("Từ file (.txt/.md/.srt)" if self.prof.get("vo_src_mode") == "file"
                                  else "Nhập trực tiếp")
            self._on_vo_src_change()

    def _sync_vo_and_save(self):
        self._sync_vo_from_widgets()
        self._vo_sync_settings_from_widgets()
        self._dirty()

    # ═════════ TTS (tạo giọng nói qua API VOICE) ═════════
    def _conn_save(self):
        save_voapi({"base_url": self.api_base.get().strip(),
                    "header_name": self.api_header.get().strip() or "xi-api-key",
                    "api_key": self.api_key.get().strip()})

    def _reset_api_status(self):
        self._api_verified = False
        if hasattr(self, "api_status"):
            self.api_status.configure(text="Chưa kiểm tra (đã đổi thông tin)", foreground="#666")

    def _verify_api(self):
        self._conn_save()
        base = self.api_base.get().strip().rstrip("/")
        header = self.api_header.get().strip() or "xi-api-key"
        key = self.api_key.get().strip()
        if not base or not key:
            self.api_status.configure(text="❌ Thiếu Base URL hoặc API key", foreground="#BA0000")
            return
        self.api_status.configure(text="Đang kiểm tra…", foreground="#666")
        self.verify_btn.configure(state="disabled")
        threading.Thread(target=self._verify_worker,
                         args=(base, header, key, self.vo_type.get()), daemon=True).start()

    def _verify_worker(self, base, header, key, api_type):
        h = {header: key}
        try:
            r = _http_json("GET", base + "/v1/credits", h, None, timeout=20)
            cr = r.get("credits")
            detail = f"✅ API key hợp lệ. Còn {cr} credits." if cr is not None else "✅ API key hợp lệ."
            ok = True
        except Exception as e:
            m = str(e)
            if "401" in m:
                detail = "❌ Key sai hoặc hết hạn (401). Tạo key mới trên web rồi dán lại."
            elif "1010" in m or "403" in m:
                detail = ("❌ Bị Cloudflare chặn (403/1010). Phiên bản này đã tự thêm User-Agent "
                          "nên thường KHÔNG còn gặp; nếu vẫn lỗi, kiểm tra mạng/proxy hoặc dán "
                          "đúng key mới nhất.")
            else:
                detail = f"❌ Không kết nối được: {e}"
            ok = False
        self.after(0, lambda: self._verify_done(ok, detail))

    def _verify_done(self, ok, msg):
        self._api_verified = ok
        self.verify_btn.configure(state="normal")
        self.api_status.configure(text=msg, foreground=("#1a7f37" if ok else "#BA0000"))
        self._log_line("Kiểm tra API: " + msg)

    def _ensure_verified(self):
        if self._api_verified:
            return True
        if messagebox.askyesno("CHƯA KIỂM TRA KẾT NỐI",
                               "Bạn chưa xác nhận API key (nút KIỂM TRA KẾT NỐI).\n\n"
                               "Kiểm tra ngay bây giờ? (Xác nhận xong, bấm lại nút vừa rồi.)"):
            self._verify_api()
            return False
        return True

    def _vo_dirty(self):
        self._vo_sync_settings_from_widgets()
        self._dirty()

    def _vo_sync_settings_from_widgets(self):
        if not hasattr(self, "vo_type"):
            return

        def _f(s, d):
            try:
                return float(str(s).replace(",", "."))
            except Exception:
                return d

        def _i(s, d):
            try:
                return int(float(str(s)))
            except Exception:
                return d
        self.prof["vo_settings"] = {
            "api_type": self.vo_type.get(),
            "voice_id": self.vo_voice.get().strip(),
            "model": self.vo_model.get().strip(),
            "speed": _f(self.vo_speed.get(), 1.0),
            "pitch": _i(self.vo_pitch.get(), 0),
            "volume": _f(self.vo_volume.get(), 1.0),
            "language": self.vo_lang.get().strip() or "auto",
            "with_srt": bool(self.vo_srt.get()),
        }

    def _vo_load_settings_into_widgets(self):
        if not hasattr(self, "vo_type"):
            return
        s = self.prof.get("vo_settings", {})
        self.vo_type.set(s.get("api_type", "minimax"))
        self.vo_voice.set(s.get("voice_id", ""))
        self.vo_model.set(s.get("model", "speech-2.8-hd"))
        self.vo_speed.set(str(s.get("speed", 1.0)))
        self.vo_pitch.set(str(s.get("pitch", 0)))
        self.vo_volume.set(str(s.get("volume", 1.0)))
        self.vo_lang.set(s.get("language", "auto"))
        self.vo_srt.set(bool(s.get("with_srt", True)))
        self._apply_type_ui()

    def _apply_type_ui(self):
        mm = self.vo_type.get() == "minimax"
        self.w_model.configure(values=MINIMAX_MODELS if mm else ELEVEN_MODELS)
        self.w_lang.configure(values=MINIMAX_LANGS if mm else ELEVEN_LANGS)
        self.w_pitch.configure(state="normal" if mm else "disabled")
        self.w_volume.configure(state="normal" if mm else "disabled")

    def _on_type_change(self):
        mm = self.vo_type.get() == "minimax"
        models = MINIMAX_MODELS if mm else ELEVEN_MODELS
        langs = MINIMAX_LANGS if mm else ELEVEN_LANGS
        if self.vo_model.get() not in models:
            self.vo_model.set(models[0])
        if self.vo_lang.get() not in langs:
            self.vo_lang.set(langs[0])
        self._apply_type_ui()
        self._vo_dirty()

    def _vo_cfg(self):
        self._conn_save()
        self._vo_sync_settings_from_widgets()
        base = self.api_base.get().strip()
        key = self.api_key.get().strip()
        if not base:
            self._warn("Chưa có Base URL trong KẾT NỐI API VOICE.")
            return None
        if not key:
            self._warn("Chưa có API key trong KẾT NỐI API VOICE.")
            return None
        s = self.prof["vo_settings"]
        return {"base": base.rstrip("/"), "header": self.api_header.get().strip() or "xi-api-key",
                "key": key, "type": s["api_type"], "voice": s["voice_id"], "model": s["model"],
                "speed": s["speed"], "pitch": s["pitch"], "volume": s["volume"],
                "lang": s["language"], "srt": s["with_srt"]}

    def _fetch_voices(self, cfg):
        h = {cfg["header"]: cfg["key"]}
        items = []
        if cfg["type"] == "minimax":
            try:
                r = _http_json("GET", cfg["base"] + "/v1/minimax/voices/cloned", h)
                for d in (r.get("data") or []):
                    items.append({"name": d.get("name", ""), "id": d.get("canonical_voice_id", ""), "kind": "nhân bản"})
            except Exception as e:
                self.msg_q.put(("log", f"(giọng nhân bản) {e}"))
            try:
                r = _http_json("GET", cfg["base"] + "/v1/minimax/voices?page=1&page_size=200", h)
                for d in (r.get("data") or []):
                    items.append({"name": d.get("name", ""), "id": d.get("canonical_voice_id", ""), "kind": "hệ thống"})
            except Exception as e:
                self.msg_q.put(("log", f"(giọng hệ thống) {e}"))
        else:
            r = _http_json("GET", cfg["base"] + "/v1/shared-voices?page_size=100&page=0", h)
            for d in (r.get("voices") or []):
                extra = " · ".join(x for x in [d.get("gender", ""), d.get("language", "")] if x)
                items.append({"name": d.get("name", ""), "id": d.get("voice_id", ""), "kind": extra})
        return items

    def _fetch_voices_dialog(self):
        cfg = self._vo_cfg()
        if not cfg:
            return
        if not self._ensure_verified():
            return
        dlg = tk.Toplevel(self)
        dlg.title("Chọn giọng")
        dlg.transient(self)
        top = ttk.Frame(dlg, padding=8)
        top.pack(fill="both", expand=True)
        info = ttk.Label(top, text="Đang tải danh sách giọng…", style="Hint.TLabel")
        info.pack(anchor="w")

        # ── Ô tìm kiếm theo TÊN hoặc ID (lọc client-side ngay khi gõ) ──
        srow = ttk.Frame(top)
        srow.pack(fill="x", pady=(4, 2))
        ttk.Label(srow, text="🔎 Tìm theo tên / ID:").pack(side="left")
        q_var = tk.StringVar()
        q_ent = ttk.Entry(srow, textvariable=q_var)
        q_ent.pack(side="left", fill="x", expand=True, padx=6)

        cols = ("name", "id", "kind")
        tv = ttk.Treeview(top, columns=cols, show="headings", selectmode="browse", height=14)
        for c, w, t in [("name", 220, "Tên"), ("id", 240, "Voice ID"), ("kind", 90, "Loại")]:
            tv.heading(c, text=t)
            tv.column(c, width=w, anchor="w")
        tv.pack(fill="both", expand=True, pady=6)
        btns = ttk.Frame(top)
        btns.pack(fill="x")

        all_items = []      # toàn bộ giọng tải về, để lọc

        def repaint(items):
            tv.delete(*tv.get_children())
            for it in items:
                tv.insert("", "end", values=(it["name"], it["id"], it["kind"]))

        def apply_filter(*_):
            q = q_var.get().strip().lower()
            if not q:
                repaint(all_items)
            else:
                repaint([it for it in all_items
                         if q in str(it["name"]).lower() or q in str(it["id"]).lower()])

        q_var.trace_add("write", apply_filter)

        def pick():
            sel = tv.selection()
            if not sel:
                return
            vid = tv.item(sel[0], "values")[1]
            if vid:
                self.vo_voice.set(vid)
                self._vo_dirty()
                dlg.destroy()
        ttk.Button(btns, text="CHỌN", style="Green.TButton", command=pick).pack(side="right")
        ttk.Button(btns, text="ĐÓNG", command=dlg.destroy).pack(side="right", padx=6)
        tv.bind("<Double-1>", lambda e: pick())
        dlg.update_idletasks()
        w, hh = dlg.winfo_reqwidth(), dlg.winfo_reqheight()
        sw, sh = dlg.winfo_screenwidth(), dlg.winfo_screenheight()
        dlg.geometry(f"640x520+{max(0,(sw-640)//2)}+{max(0,(sh-520)//2)}")

        def fill(items, err):
            if err is not None:
                hint = ""
                if "1010" in err or "403" in err or "401" in err:
                    hint = ("\n→ Bấm KIỂM TRA KẾT NỐI. Nếu 401: dán key mới nhất. "
                            "Nếu 403/1010 (Cloudflare): bản này đã tự thêm User-Agent nên "
                            "thường đã hết — thử lại hoặc kiểm tra mạng/proxy.")
                info.configure(text=f"Lỗi tải giọng: {err}{hint}", wraplength=580)
                return
            all_items[:] = items
            info.configure(text=f"{len(items)} giọng — gõ ô tìm kiếm để lọc, double-click hoặc CHỌN:",
                           wraplength=580)
            apply_filter()

        def work():
            try:
                items = self._fetch_voices(cfg)
                self.after(0, lambda: fill(items, None))
            except Exception as e:
                self.after(0, lambda: fill(None, str(e)))
        threading.Thread(target=work, daemon=True).start()

    def _run_tts(self):
        if not self._guard_busy():
            return
        cfg = self._vo_cfg()
        if not cfg:
            return
        if not self._ensure_verified():
            return
        text = self.vo_out.get("1.0", "end").strip()
        if not text:
            text = clean_vo(self._get_script_text())
            if text:
                self.vo_out.delete("1.0", "end")
                self.vo_out.insert("1.0", text)
                self._sync_vo_and_save()
        if not text:
            return self._warn("Chưa có nội dung VO. Dán /script rồi bấm XUẤT VO 1 ĐOẠN.")
        if not cfg["voice"]:
            return self._warn("Chưa có Voice ID. Bấm 'LẤY DANH SÁCH GIỌNG' hoặc dán ID vào ô.")
        outdir = self.vo_out_path.get().strip()
        if not outdir:
            return self._warn("Chưa chọn thư mục lưu. Bấm 'CHỌN…' ở ô 'Lưu VO.mp3 + sub.srt vào'.")
        if not Path(outdir).is_dir():
            return self._warn("Thư mục lưu không hợp lệ. Bấm 'CHỌN…' để chọn lại folder.")
        # RESET kết quả cũ: TẠO VO chỉ tạo & giữ trong bộ nhớ; XUẤT VO / XUẤT SRT mới ghi ra file.
        self._vo_done = False
        self._vo_tmp_mp3 = ""
        self._vo_srt_text = ""
        self._vo_ctx = None
        tmp_mp3 = str(APP_DIR / "_vo_tmp.mp3")
        self._tts_busy = True
        self._tts_cancel = False
        self._update_tts_btn_state()
        self.stop_btn.configure(state="normal")
        self.tts_status.configure(text="⏳ working…", foreground="#8a5a00")
        self._log_line(f"\n▶ TẠO VO ({cfg['type']})  (audio + phụ đề, giữ trong bộ nhớ chờ XUẤT)")
        self.status.configure(text="Đang tạo giọng nói…")
        threading.Thread(target=self._tts_worker, args=(cfg, text, tmp_mp3), daemon=True).start()

    def _tts_worker(self, cfg, text, mp3_path):
        want_srt = bool(cfg["srt"])
        try:
            h = {cfg["header"]: cfg["key"]}
            if cfg["type"] == "minimax":
                url = cfg["base"] + "/v1/minimax/text-to-speech/async"
                # Payload khớp ĐÚNG với request web (đã soi F12): canonical_voice_id, KHÔNG có
                # "format", và cờ phụ đề tên là "with_transcript" (KHÔNG phải "subtitle_enable").
                body = {"canonical_voice_id": cfg["voice"], "text": text, "model": cfg["model"],
                        "speed": cfg["speed"], "pitch": cfg["pitch"], "volume": cfg["volume"],
                        "language_boost": cfg["lang"],
                        "client_task_uuid": str(uuid.uuid4())}
                if want_srt:
                    # ai84.pro (proxy MiniMax) nhận cờ phụ đề dưới tên "with_transcript"; server
                    # trả "transcript_url" trong job → app tự tải + dựng SRT từ đó.
                    for _flag in MINIMAX_SUBTITLE_FLAGS:
                        body[_flag] = True
                    self.msg_q.put(("log", f"(đã gửi cờ phụ đề: {', '.join(MINIMAX_SUBTITLE_FLAGS)})"))
            else:
                url = cfg["base"] + "/v2/text-to-speech/async"
                body = {"text": text, "voice_id": cfg["voice"], "model_id": cfg["model"],
                        "with_transcript": want_srt,
                        "voice_settings": {"speed": cfg["speed"]},
                        "output_format": "mp3_44100_128"}
                if cfg["lang"] and cfg["lang"] != "auto":
                    body["language_code"] = cfg["lang"]
            self.msg_q.put(("log", "Gửi yêu cầu tạo job…"))
            resp = self._tts_post(url, h, body)   # tự thử lại nếu server từ chối cờ phụ đề
            job_id = resp.get("job_id") or (resp.get("job") or {}).get("job_id")
            if not job_id:
                raise RuntimeError(f"Không nhận được job_id. Phản hồi: {resp}")
            self.msg_q.put(("log", f"Job {job_id} (credit ~{resp.get('credit_cost')}). Đang xử lý…"))
            # endpoint chung /v1/task/{id} trả audio_url + phụ đề cho mọi loại
            task_url = cfg["base"] + "/v1/task/" + str(job_id)
            # endpoint RIÊNG theo loại — một số bản proxy chỉ gắn srt_url ở đây,
            # không gắn ở /v1/task → khi thiếu SRT sẽ hỏi thêm endpoint này.
            alt_url = (cfg["base"] + "/v1/minimax/text-to-speech/async/" + str(job_id)
                       if cfg["type"] == "minimax"
                       else cfg["base"] + "/v2/text-to-speech/async/" + str(job_id))
            audio_url = srt_url = ""
            last_jr = {}
            # Chờ TỐI ĐA 20 phút (video 12-16 phút có thể mất hơn 6 phút để render).
            # GIÃN NHỊP HỎI: lúc đầu hỏi dồn (2s) cho job ngắn, sau thưa dần tới 10s để đỡ
            # spam server — 2, 3, 4, ... , 10, 10, 10 s.
            deadline = time.time() + 20 * 60
            interval = 2
            while time.time() < deadline:
                if self._tts_cancel:
                    raise RuntimeError("Đã dừng theo yêu cầu.")
                time.sleep(interval)
                interval = min(interval + 1, 10)
                jr = _http_json("GET", task_url, h, None, timeout=30)
                last_jr = jr
                st, audio_url, srt_url, err = _extract_task_result(jr)
                if want_srt and not srt_url and not _build_srt_text(jr):
                    # /v1/task không kèm phụ đề → thử endpoint riêng của loại TTS.
                    try:
                        jr2 = _http_json("GET", alt_url, h, None, timeout=30)
                        st2, au2, srt2, _e2 = _extract_task_result(jr2)
                        if srt2 or _build_srt_text(jr2):
                            jr = jr2
                            last_jr = jr2
                            srt_url = srt2 or srt_url
                            audio_url = audio_url or au2
                            st = st or st2
                    except Exception:
                        pass
                self.msg_q.put(("status", f"Trạng thái: {st or '...'}"))
                if st in ("failed", "error"):
                    raise RuntimeError(err or "Job thất bại.")
                is_terminal = st in ("done", "completed", "success", "succeeded")
                if not want_srt:
                    # Không cần phụ đề: có audio (hoặc job xong) là dừng ngay.
                    if audio_url or is_terminal:
                        break
                else:
                    # Cần phụ đề: đợi tới khi có SRT (URL hoặc dữ liệu dựng được);
                    # nếu job đã xong hẳn mà vẫn có audio thì cũng dừng (sẽ tự dựng/không có SRT).
                    have_srt = bool(srt_url) or bool(_build_srt_text(jr))
                    if audio_url and (have_srt or is_terminal):
                        break
            if not audio_url:
                raise RuntimeError("Quá thời gian chờ (20 phút), chưa có audio.")
            if not audio_url.startswith("http"):
                audio_url = cfg["base"] + audio_url
            if srt_url and not srt_url.startswith("http"):
                srt_url = cfg["base"] + srt_url
            self.msg_q.put(("log", "Tải audio…"))
            _http_download(audio_url, mp3_path)   # tải về FILE TẠM; XUẤT VO sẽ copy sang thư mục đích
            # Dựng SRT vào bộ nhớ. Transcript thường sinh TRỄ hơn audio vài giây → nếu chưa có,
            # hỏi thêm endpoint riêng của loại TTS tối đa ~90s cho tới khi transcript xuất hiện.
            srt_text = ""
            if want_srt:
                srt_text = self._collect_srt_text(cfg, job_id, last_jr, srt_url)
                if srt_text:
                    self.msg_q.put(("log", "✅ Đã lấy được phụ đề (giữ trong bộ nhớ, bấm XUẤT SRT để lưu)."))
                else:
                    self.msg_q.put(("log", "⚠️ Chưa lấy được phụ đề dù đã chờ. Vẫn có thể bấm XUẤT SRT để thử lại."))
            # Lưu ngữ cảnh để XUẤT SRT có thể thử lấy lại nếu cần.
            self._vo_ctx = {"cfg": cfg, "job_id": job_id, "last_jr": last_jr, "srt_url": srt_url}
            self.msg_q.put(("log", f"✅ Xong audio (tạm): {mp3_path}"))
            self.msg_q.put(("tts_status", ("✅ done", "#1a7f37")))
            self.msg_q.put(("vo_ready", {"mp3": mp3_path, "srt_text": srt_text, "want_srt": want_srt}))
        except Exception as e:
            self.msg_q.put(("log", f"[Lỗi TTS] {e}"))
            self.msg_q.put(("tts_status", ("❌ lỗi", "#BA0000")))
        finally:
            self.msg_q.put(("done", None))

    def _collect_srt_text(self, cfg, job_id, last_jr, srt_url):
        """Trả về nội dung SRT thật (có '-->'), hoặc '' nếu không có. Thử ngay từ dữ liệu đã có,
        rồi (nếu chưa có) hỏi thêm endpoint riêng của loại TTS + endpoint /v1/task, chờ tối đa
        ~90s vì transcript sinh trễ hơn audio."""
        txt = _srt_content_from(srt_url, last_jr)
        if txt:
            return txt
        h = {cfg["header"]: cfg["key"]}
        alt_url = (cfg["base"] + "/v1/minimax/text-to-speech/async/" + str(job_id)
                   if cfg["type"] == "minimax"
                   else cfg["base"] + "/v2/text-to-speech/async/" + str(job_id))
        task_url = cfg["base"] + "/v1/task/" + str(job_id)
        deadline = time.time() + 90
        interval = 3
        while time.time() < deadline:
            if getattr(self, "_tts_cancel", False):
                break
            for u in (alt_url, task_url):
                try:
                    jr = _http_json("GET", u, h, None, timeout=30)
                except Exception:
                    continue
                _st, _au, s_url, _e = _extract_task_result(jr)
                if s_url and not s_url.startswith("http"):
                    s_url = cfg["base"] + s_url
                txt = _srt_content_from(s_url, jr)
                if txt:
                    return txt
            self.msg_q.put(("log", "Chờ phụ đề (transcript sinh trễ hơn audio)…"))
            time.sleep(interval)
            interval = min(interval + 1, 8)
        return ""

    def _export_vo(self):
        """Lưu VO.mp3 (từ file tạm) vào thư mục đã chọn."""
        if not getattr(self, "_vo_done", False):
            return self._warn("Chưa có VO. Bấm TẠO VO trước.")
        tmp = getattr(self, "_vo_tmp_mp3", "")
        if not tmp or not Path(tmp).is_file():
            return self._warn("Không tìm thấy dữ liệu VO tạm. Bấm TẠO VO lại.")
        outdir = self.vo_out_path.get().strip()
        if not outdir or not Path(outdir).is_dir():
            return self._warn("Thư mục lưu không hợp lệ. Bấm 'CHỌN…' để chọn lại folder.")
        dst = str(Path(outdir) / "VO.mp3")
        try:
            shutil.copyfile(tmp, dst)
        except Exception as e:
            return self._warn(f"Ghi VO.mp3 lỗi: {e}")
        if hasattr(self, "v_audio"):
            self.v_audio.set(dst)               # tự điền sang tab Media (khớp tổng thời lượng)
        self._log_line(f"✅ Đã lưu VO: {dst}")
        self._set_status(f"Đã lưu VO.mp3 vào {outdir} + điền Audio VO sang tab Media.")

    def _export_srt(self):
        """Lưu sub.srt (từ bộ nhớ) vào thư mục đã chọn + điền sang tab Media. Nếu chưa có,
        thử lấy lại nhanh 1 lần trước khi báo."""
        if not getattr(self, "_vo_done", False):
            return self._warn("Chưa có VO. Bấm TẠO VO trước.")
        outdir = self.vo_out_path.get().strip()
        if not outdir or not Path(outdir).is_dir():
            return self._warn("Thư mục lưu không hợp lệ. Bấm 'CHỌN…' để chọn lại folder.")
        srt_text = getattr(self, "_vo_srt_text", "")
        if not srt_text or "-->" not in srt_text:
            srt_text = self._retry_fetch_srt()      # thử lấy lại nhanh
            if srt_text:
                self._vo_srt_text = srt_text
        if not srt_text or "-->" not in srt_text:
            return self._warn("Chưa lấy được phụ đề (SRT) cho job này.\n\n"
                              "Kiểm tra ô 'Xuất kèm SRT' đã bật khi TẠO VO, hoặc bấm TẠO VO lại.")
        dst = str(Path(outdir) / "sub.srt")
        try:
            Path(dst).write_text(srt_text if srt_text.endswith("\n") else srt_text + "\n",
                                 encoding="utf-8")
        except Exception as e:
            return self._warn(f"Ghi sub.srt lỗi: {e}")
        if hasattr(self, "v_srt"):
            self.v_srt.set(dst)                     # tự điền sang tab Media
        self._log_line(f"✅ Đã lưu SRT: {dst}")
        self._set_status(f"Đã lưu sub.srt vào {outdir} + điền SRT sang tab Media.")

    def _retry_fetch_srt(self):
        """Thử lấy lại phụ đề NHANH (1 vòng, không chờ lâu) từ endpoint riêng + /v1/task."""
        ctx = getattr(self, "_vo_ctx", None)
        if not ctx:
            return ""
        cfg = ctx.get("cfg"); job_id = ctx.get("job_id")
        if not cfg or not job_id:
            return ""
        h = {cfg["header"]: cfg["key"]}
        alt_url = (cfg["base"] + "/v1/minimax/text-to-speech/async/" + str(job_id)
                   if cfg["type"] == "minimax"
                   else cfg["base"] + "/v2/text-to-speech/async/" + str(job_id))
        task_url = cfg["base"] + "/v1/task/" + str(job_id)
        # thử dữ liệu đã có trước
        t = _srt_content_from(ctx.get("srt_url") or "", ctx.get("last_jr") or {})
        if t:
            return t
        for u in (alt_url, task_url):
            try:
                jr = _http_json("GET", u, h, None, timeout=30)
            except Exception:
                continue
            _st, _au, s_url, _e = _extract_task_result(jr)
            if s_url and not s_url.startswith("http"):
                s_url = cfg["base"] + s_url
            t = _srt_content_from(s_url, jr)
            if t:
                return t
        return ""

    def _tts_post(self, url, h, body):
        """POST tạo job TTS. Nếu server từ chối cờ phụ đề phụ (subtitle_enable) thì gửi lại không kèm,
        để phần audio vẫn chạy — SRT sẽ được dựng tại chỗ từ transcript nếu có."""
        try:
            return _http_json("POST", url, h, body, timeout=60)
        except RuntimeError as e:
            msg = str(e)
            has_flag = any(f in body for f in MINIMAX_SUBTITLE_FLAGS)
            if has_flag and (" 400" in msg or " 422" in msg
                             or "subtitle" in msg.lower() or "transcript" in msg.lower()):
                b2 = dict(body)
                for f in MINIMAX_SUBTITLE_FLAGS:
                    b2.pop(f, None)
                self.msg_q.put(("log", "(server từ chối cờ phụ đề — gửi lại không kèm, sẽ tự dựng SRT nếu có transcript)"))
                return _http_json("POST", url, h, b2, timeout=60)
            raise

