    @staticmethod
    def _scan_job_images(folder):
        """Quét folder ảnh, trả về (by_job, done_ids, other).
        by_job  {số job: [file,…]} — ảnh G-Labs mới tải, tên bắt đầu bằng số job.
        done_ids [stem,…]          — ảnh ĐÃ đúng tên (001, 042a…), gồm cả ảnh pose đã chép.
        other    [tên,…]           — ảnh không đọc được số."""
        exts = {".png", ".jpg", ".jpeg", ".webp", ".bmp"}
        by_job, done_ids, other = {}, [], []
        try:
            files = sorted(Path(folder).iterdir(), key=lambda x: x.name.lower())
        except OSError:
            return by_job, done_ids, other
        for p in files:
            if not (p.is_file() and p.suffix.lower() in exts):
                continue
            if ELEMENT_STEM_RE.match(p.stem) or re.fullmatch(r"\d{1,4}", p.stem):
                done_ids.append(p.stem)
                continue
            m = re.match(r"^\s*(\d+)", p.stem)
            if m:
                by_job.setdefault(int(m.group(1)), []).append(p)
            else:
                other.append(p.name)
        return by_job, done_ids, other

    @staticmethod
    def _detect_batch_offset(targets, by_job):
        """Dò job 1 của đợt này ứng với prompt thứ mấy, bằng ĐỐI CHIẾU PROMPT.

        Vì sao phải đối chiếu chứ không đếm ảnh đã có trong folder: mỗi đợt tải về một
        folder Task_… riêng, nên folder của đợt sau KHÔNG chứa ảnh của đợt trước; còn ảnh
        pose đã chép thì rải đều cả tập nên không nói lên được gì.

        Cách làm: thử mọi mốc, mỗi mốc chấm điểm xem bao nhiêu job có 30 ký tự đầu của
        prompt (G-Labs nhét vào tên file) khớp với prompt tại vị trí đó. Ảnh nền cùng bối
        cảnh có tên giống hệt nhau nên không phân biệt được, nhưng ảnh con element thì tên
        riêng biệt — chính chúng ghim ra mốc đúng.

        Trả về (off, điểm_quán_quân, điểm_á_quân, số_job_dùng_để_chấm);
        off = None nếu không có job nào chấm được."""
        n_t = len(targets)
        jobs = sorted(by_job)
        fkeys = {j: _img_desc_key(by_job[j][0].name) for j in jobs}
        usable = [j for j in jobs if len(fkeys[j]) >= 8]
        if not usable or not n_t:
            return None, 0, 0, 0
        best_off, best_ok, second_ok = None, -1, 0
        for off in range(n_t):
            ok = 0
            for j in usable:
                i = off + j - 1
                if i >= n_t:
                    break
                key = targets[i][1]
                fk = fkeys[j]
                if fk.startswith(key[:len(fk)]) or key.startswith(fk[:len(key)]):
                    ok += 1
            if ok > best_ok:
                second_ok, best_ok, best_off = best_ok, ok, off
            elif ok > second_ok:
                second_ok = ok
        return best_off, best_ok, max(second_ok, 0), len(usable)

    # ── NHẬT KÝ G-LABS: tra tên file gốc ra prompt ──────────────────────────
    def _glabs_dir(self):
        """Thư mục nhật ký đang dùng: ô CHANNEL CONFIG, trống thì lấy trong %APPDATA%."""
        p = _clean_path(self.prof.get("glabs_dir", "") or "")
        return Path(p) if p else DEFAULT_GLABS_SESSION_DIR

    def _glabs_prompt_map(self, folder):
        """{tên file gốc (chữ thường): prompt} cho mọi ảnh mà nhật ký ghi là đã lưu vào `folder`.

        G-Labs ghi mỗi phiên thành một file session_*.json, trong đó `flow_data` là danh sách
        {prompt, outputs: [đường dẫn ảnh đã lưu]}. Nhờ vậy tra ngược tên file ra prompt được —
        không phải đoán mốc số job nữa.

        Ưu tiên khớp ĐÚNG CẢ ĐƯỜNG DẪN; không có mới khớp theo TÊN thư mục (phòng khi folder
        đã được chuyển chỗ). Trả về (bản_đồ, số_file_nhật_ký_đọc_được, lời_báo_lỗi)."""
        d = self._glabs_dir()
        if not d.is_dir():
            return {}, 0, f"Không thấy thư mục nhật ký G-Labs:\n{d}"
        try:
            files = sorted(d.glob("session_*.json"), key=lambda p: p.stat().st_mtime)
        except OSError as e:
            return {}, 0, str(e)
        want = Path(folder)
        by_path, by_name, nfile = {}, {}, 0
        for sf in files:
            try:
                data = json.loads(sf.read_text(encoding="utf-8"))
            except (OSError, ValueError, UnicodeDecodeError):
                continue
            nfile += 1
            for it in (data.get("flow_data") or []):
                pr = (it.get("prompt") or "").strip()
                if not pr:
                    continue
                for o in (it.get("outputs") or []):
                    try:
                        op = Path(str(o))
                    except (TypeError, ValueError):
                        continue
                    if op.parent == want:
                        by_path[op.name.lower()] = pr
                    elif op.parent.name.lower() == want.name.lower():
                        by_name[op.name.lower()] = pr
        return (by_path or by_name), nfile, ""

    def _map_by_glabs(self, targets, by_job, folder):
        """Ghép job -> vị trí prompt bằng nhật ký: tên file gốc -> prompt -> số ảnh.

        Hai scene có thể mang prompt y hệt nhau (cùng nền, cùng tư thế, cùng góc máy), khi đó
        một prompt ứng với nhiều đích — giải bằng THỨ TỰ: job tăng dần thì số ảnh cũng tăng dần.

        Trả về (resolved {job: chỉ_số_prompt}, số_file_nhật_ký, lời_báo_lỗi)."""
        namemap, nfile, err = self._glabs_prompt_map(folder)
        if not namemap:
            return {}, nfile, err
        full = {}
        for i, t in enumerate(targets):
            full.setdefault(t[2], []).append(i)
        cand = {}
        for j in sorted(by_job):
            pr = namemap.get(by_job[j][0].name.lower())
            if pr is None:
                continue
            hits = full.get(_norm_match(pr))
            if hits:
                cand[j] = hits
        resolved, used, last = {}, set(), -1
        for j in sorted(cand):
            free = [i for i in cand[j] if i not in used]
            if not free:
                continue
            later = [i for i in free if i > last]
            pick = later[0] if later else free[0]
            resolved[j] = pick
            used.add(pick)
            last = pick
        return resolved, nfile, err

    @staticmethod
    def _offset_is_clear(ok1, ok2, n_use):
        """Mốc dò ra có đủ rõ để tự dùng không? Cần vừa khớp NHIỀU, vừa bỏ xa mốc á quân —
        lệch một nhịp mà vẫn khớp gần bằng nghĩa là không phân biệt được, phải hỏi người dùng."""
        return bool(n_use) and ok1 >= 3 and ok1 >= 0.5 * n_use and ok1 >= ok2 * 1.5

    def _schedule_batch_suggest(self):
        job = getattr(self, "_batch_suggest_job", None)
        if job:
            try:
                self.after_cancel(job)
            except Exception:
                pass
        self._batch_suggest_job = self.after(600, lambda: self._suggest_batch_start(loud=False))

    def _suggest_batch_start(self, loud=False):
        """Dò mốc của đợt ảnh đang nằm trong folder rồi điền sẵn vào ô cho người dùng xem/sửa.
        Trả về tên ảnh ứng với job 1, hoặc '' nếu chưa dò chắc được."""
        folder = _clean_path(self.media_folder.get())
        if not folder or not Path(folder).is_dir():
            if loud:
                self._warn("Chọn FOLDER ẢNH hợp lệ trước (ô trên cùng tab MEDIA).")
            return ""
        targets = self._prompt_targets()
        if not targets:
            if loud:
                self._warn("Tab PROMPT chưa có scene nào. Nhập SCENES trước.")
            return ""
        by_job, done_ids, _other = self._scan_job_images(folder)
        if not by_job:
            self.rn_batch_start.set("")
            if loud:
                self._set_status(f"Dò lô: folder chưa có ảnh G-Labs nào chờ đổi tên "
                                 f"({len(done_ids)} ảnh đã đúng tên).")
            return ""
        names = [t[0] for t in targets]
        # 1) Nhật ký G-Labs: tra thẳng tên file gốc ra prompt — chắc nhất, thử trước.
        resolved, nfile, _err = self._map_by_glabs(targets, by_job, folder)
        if resolved:
            # Để TRỐNG ô mốc: có nhật ký rồi thì đổi tên tra thẳng từng ảnh, khỏi cần mốc.
            # (Gõ vào ô này = ép dùng cách dò mốc, bỏ qua nhật ký.)
            self.rn_batch_start.set("")
            j0, jl = min(resolved), max(resolved)
            if loud:
                self._set_status(f"Nhật ký G-Labs: tra được {len(resolved)}/{len(by_job)} ảnh · "
                                 f"job {j0} = {names[resolved[j0]]} → job {jl} = {names[resolved[jl]]}.")
            return names[resolved[j0]]
        # 2) Không có nhật ký -> dò mốc bằng đối chiếu prompt.
        off, ok1, ok2, n_use = self._detect_batch_offset(targets, by_job)
        if off is None or not self._offset_is_clear(ok1, ok2, n_use):
            self.rn_batch_start.set("")
            if loud:
                guess = f" (đoán {names[off]}, chỉ {ok1}/{n_use} job khớp)" if off is not None else ""
                self._set_status(f"Dò lô: CHƯA chắc job 1 là ảnh nào{guess} — gõ tay số ảnh vào ô bên trái.")
            return ""
        self.rn_batch_start.set(names[off])
        if loud:
            last = min(off + max(by_job) - 1, len(names) - 1)
            self._set_status(f"Dò lô: {len(by_job)} job · job 1 = {names[off]} → job cuối = {names[last]} "
                             f"({ok1}/{n_use} job khớp prompt) — không dùng nhật ký.")
        return names[off]

