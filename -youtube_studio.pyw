    def _pose_dir(self):
        """Thư mục thư viện đang dùng: ô CHANNEL CONFIG, để trống thì lấy pose_library cạnh app."""
        p = _clean_path(self.prof.get("pose_dir", "") or "")
        return Path(p) if p else DEFAULT_POSE_DIR

    def _pose_rows(self):
        """[(số_scene, tên_tư_thế)] của mọi dòng beat câu nối ở tab PROMPT."""
        out = []
        for r in self._recompute_prompts(self.prof.get("prompts", [])):
            if r.get("_virtual") or not r.get("id"):
                continue
            nm = pose_name_of(r.get("action", ""))
            if nm:
                out.append((r["id"], nm))
        return out

    def _copy_pose_images(self):
        """Chép ảnh tư thế từ thư viện vào folder ảnh, đặt tên theo số scene (vd 007.jpg).
        Dòng pose không có prompt nên G-Labs không sinh ảnh cho nó — đây là chỗ bù vào.
        Chạy SAU khi đổi tên lô G-Labs, vì có thể phải xoá file trùng số ở đuôi khác."""
        folder = _clean_path(self.media_folder.get())
        if not folder or not os.path.isdir(folder):
            return self._warn("Chọn FOLDER ẢNH trước (ô trên cùng tab MEDIA).")
        rows = self._pose_rows()
        if not rows:
            return self._warn("Tab PROMPT không có dòng nào dùng cờ [FN: pose:…].\n\n"
                              "Cú pháp: cột Action bắt đầu bằng [FN: pose:thinking].")
        lib = self._pose_dir()
        if not lib.is_dir():
            return self._warn(f"Không thấy thư mục THƯ VIỆN TƯ THẾ:\n{lib}\n\n"
                              "Đặt lại đường dẫn ở tab CHANNEL CONFIG.")
        dest = Path(folder)
        plan, missing, clash = [], [], []
        for sid, nm in rows:
            src = next((lib / (nm + e) for e in POSE_EXTS if (lib / (nm + e)).is_file()), None)
            if src is None:
                missing.append(f"{sid} → {nm}")
                continue
            old = [p for e in POSE_EXTS if (p := dest / (sid + e)).is_file()]
            if old:
                clash.append(f"{sid}: {', '.join(p.name for p in old)}")
            plan.append((sid, nm, src, old))
        if missing:
            self._warn("Thiếu file trong thư viện, các dòng này sẽ bị bỏ qua:\n\n  "
                       + "\n  ".join(missing) +
                       f"\n\nThư viện: {lib}")
        if not plan:
            return
        if clash and not messagebox.askyesno(
                "⚠ GHI ĐÈ ẢNH ĐANG CÓ",
                f"{len(clash)} số scene đã có ảnh trong folder, sẽ bị thay bằng ảnh tư thế:\n\n  "
                + "\n  ".join(clash[:10]) + ("\n  …" if len(clash) > 10 else "") + "\n\nTiếp tục?"):
            return
        self._clear_log()
        ok = 0
        for sid, nm, src, old in plan:
            try:
                for p in old:                      # xoá mọi đuôi trùng số để find_image không lấy nhầm
                    p.unlink()
                shutil.copy2(src, dest / (sid + src.suffix.lower()))
                ok += 1
                self._log_line(f"  {sid}{src.suffix.lower()}  ←  {nm}")
            except OSError as e:
                self._log_line(f"⚠️  {sid} ← {nm}: {e}")
        self._log_line(f"✅ Đã chép {ok}/{len(plan)} ảnh tư thế từ {lib}")
        self._set_status(f"Chép ảnh pose xong: {ok}/{len(plan)}.")

    def _path_row(self, parent, r, label, var, kind="dir", filetypes=None, open_btn=True):
        ttk.Label(parent, text=label).grid(row=r, column=0, sticky="w", pady=4)
        ttk.Entry(parent, textvariable=var).grid(row=r, column=1, sticky="ew", padx=6, pady=4)

        def browse():
            cur = (var.get() or "").strip()
            cur_path = Path(cur) if cur else None
            # Thư mục khởi tạo: lấy từ giá trị hiện có, fallback về home
            if kind == "dir":
                init_dir = cur if (cur and os.path.isdir(cur)) else str(Path.home())
            else:
                init_dir = (str(cur_path.parent)
                            if (cur_path and cur_path.parent.exists())
                            else str(Path.home()))
            if kind == "dir":
                p = filedialog.askdirectory(title=label, initialdir=init_dir)
            elif kind == "save":
                # Điền sẵn TÊN FILE để nút Save không bị xám trên Windows
                init_file = (cur_path.name if (cur_path and cur_path.name) else "output.mp4")
                p = filedialog.asksaveasfilename(title=label, defaultextension=".mp4",
                                                 initialdir=init_dir, initialfile=init_file,
                                                 filetypes=[("MP4", "*.mp4"), ("Tất cả", "*.*")])
            else:
                p = filedialog.askopenfilename(title=label, initialdir=init_dir,
                                               filetypes=filetypes or [("Tất cả", "*.*")])
            if p:
                var.set(p)
        ttk.Button(parent, text="CHỌN…", command=browse, width=8)\
            .grid(row=r, column=2, padx=(0, 4), pady=4)
        if open_btn:
            def _open_target():
                v = (var.get() or "").strip()
                if not v:
                    return open_in_explorer(str(Path.home()))
                p = Path(v)
                if kind == "dir":
                    tgt = v if p.is_dir() else str(Path.home())
                elif p.exists():          # file/save đã tồn tại -> mở chính nó
                    tgt = v
                elif p.parent.exists():   # chưa tồn tại (vd output.mp4) -> mở thư mục chứa
                    tgt = str(p.parent)
                else:
                    tgt = str(Path.home())
                open_in_explorer(tgt)
            ttk.Button(parent, text=FOLDER_ICON, width=3, command=_open_target)\
                .grid(row=r, column=3, pady=4)
        parent.columnconfigure(1, weight=1)

