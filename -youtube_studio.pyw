# 27/09/2026: câu ánh sáng ngày/đêm là 2 ô DAY LIGHT / NIGHT LIGHT ở CHANNEL CONFIG (người
# dùng sửa được). Hai hằng dưới chỉ là giá trị khởi tạo cho hồ sơ chưa có ô này.
DAY_LIGHT_DEFAULT = "Daytime scene in soft warm natural daylight"
NIGHT_LIGHT_DEFAULT = ("Nighttime scene lit only by the light sources that belong in this place — "
                       "lamps only indoors, streetlights and moonlight outdoors or inside a vehicle")


def _light_clause(raw, day_light="", night_light=""):
    """Chọn ô DAY LIGHT hay NIGHT LIGHT theo cột time; ô trống -> không thêm câu ánh sáng."""
    txt = night_light if "night" in (raw or "").lower() else day_light
    return (txt or "").strip().rstrip(".")


def _tidy_dots(s):
    """Gộp dấu chấm thừa khi ghép câu (vd 'background style.. NO' -> 'background style. NO')."""
    return re.sub(r"\.(?:[ \t]*\.)+", ".", s or "")


def _one_line(s):
    """Ép prompt về ĐÚNG 1 dòng: mọi khoảng trắng liên tiếp (kể cả xuống dòng/tab do
    người dùng lỡ dán style nhiều dòng) gộp thành 1 space. Bảo đảm mỗi prompt copy sang
    G-Labs là 1 dòng, không bị vỡ thành nhiều prompt."""
    return re.sub(r"\s+", " ", (s or "")).strip()


# ── ĐỌC PHẦN TẢ RIÊNG NHÂN VẬT CỦA 1 BEAT CONCEPT ──────────────────────────
# LƯU Ý QUY ƯỚC DỰ ÁN: app KHÔNG được chứa câu chữ prompt nào. Mọi câu tả style/luật vẽ
# đều phải do người dùng gõ trong tab CHANNEL CONFIG. App chỉ ráp và CHỌN ô style nào.
# ── BEAT CÂU NỐI DÙNG THƯ VIỆN TƯ THẾ (08/09/2026) ─────────────────────────
# Câu nối ("Here's what's actually happening") không đáng gen một ảnh riêng: cho nó dùng lại
# một trong các file tư thế có sẵn. Dòng scene ghi cờ [FN: pose:thinking] -> app KHÔNG sinh
# prompt cho dòng đó (cột PROMPT để trống), nên dòng này tự động không nằm trong lô COPY
# SELECTED PROMPT lẫn bảng đối chiếu số job khi ĐỔI TÊN — cả hai chỗ đều bỏ qua prompt rỗng,
# nhờ vậy số thứ tự ảnh G-Labs không bị lệch. Ảnh của dòng này do nút CHÉP ẢNH POSE chép vào.
# 28/09/2026: thêm dạng "[FN: present pose:explaining]" / "[FN: list pose:reading]" = beat CÓ
# mảnh ảnh phụ, nhưng ảnh NỀN (Fred một mình trên nền trắng) lấy luôn từ thư viện thay vì gen.
# Nhóm 1 = present/list (trống với beat câu nối cũ), nhóm 2 = tên tư thế.
POSE_FN_RE = re.compile(r"^\s*\[FN:\s*(?:(present|list)\s+)?pose\s*:\s*"
                        r"([A-Za-z0-9][A-Za-z0-9_\-]*)\s*\]", re.IGNORECASE)
POSE_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".bmp")


# "{cell 3}" hoặc (25/09/2026) "{cell 3 @amygdala}" — chữ sau @ là mốc để mảnh hiện đúng lúc đọc
# 02/10/2026: thêm "{pov @sorry}" = ảnh POV làm ảnh phụ của cảnh nhắn tin (xem POV_CELL)
CELL_MARK_RE = re.compile(r"\{\s*(?:cell\s*\d?|pov)\s*(?:@[^}]*)?\}", re.IGNORECASE)


def has_scene_pieces(action):
    """Dòng cảnh đời thường có mảnh ảnh phụ (SCENE PIECES, 24/09/2026) = có ít nhất 1 {cell N}.
    Cảnh đời thường không có cờ [FN] (action phải mở đầu bằng câu giữ trạng thái)."""
    return bool(CELL_MARK_RE.search(action or ""))


def pose_name_of(action):
    """Tên tư thế lấy từ thư viện của 1 dòng (beat câu nối, hoặc beat present/list dùng ảnh
    nền có sẵn), '' nếu dòng đó gen ảnh nền như thường."""
    m = POSE_FN_RE.match(action or "")
    return m.group(2).lower() if m else ""


def pose_has_pieces(action):
    """True nếu dòng dùng ảnh nền thư viện NHƯNG vẫn có mảnh ảnh phụ ([FN: present pose:…])."""
    m = POSE_FN_RE.match(action or "")
    return bool(m and m.group(1))


def _concept_base_pose(raw_action):
    """(fn, pose) của 1 beat CONCEPT — pose là phần tả RIÊNG Fred, đã bỏ hết mô tả đồ vật.
    Dùng chung bộ đọc mảnh với script sinh draft nên luôn khớp với ảnh con sinh ra.
    Không nạp được bộ đọc / đọc lỗi -> ("present", "") để hàm gọi tự fallback về action gốc."""
    if _parse_concept_action is None:
        return "present", ""
    try:
        fn, pose, _pieces = _parse_concept_action(raw_action or "")
    except Exception:
        return "present", ""
    return fn, (pose or "").strip()


def build_prompt_row(char, bg, act, cam, tm, scene_style, concept_style=None,
                     concept_solo_style=None, metaphor_style=None, day_light="", night_light=""):
    """Ráp 1 scene prompt. Cột Character tách dấu phẩy -> mỗi tên 1 token có ngoặc.
    Scene 1 nhân vật (mọi CONCEPT + scene thường solo): BỎ token [tên] mở đầu action để
    prompt không lặp tên (head đã có "[tên] in [bg]"). Ra: "[fred] in [fred-white], <action>. ..."
    Scene nhiều nhân vật: giữ nguyên brackets trong action.
    concept_style != None  (scene CONCEPT — nền của protagonist có tick 'dùng concept'):
    DÙNG conceptStyle THAY cho sceneStyle, bỏ câu ánh sáng day/night (nền void không có
    ngày/đêm); conceptStyle đã tự khoá 1 nhân vật + nền trắng trơn.
    concept_style=None -> scene thường (sceneStyle + ánh sáng theo Time).

    Đợt 3 (07/09/2026): beat CONCEPT loại present / list (= loại CÓ sinh ảnh con) thì prompt
    ảnh NỀN chỉ giữ phần tả Fred, CẮT HẾT mô tả đồ vật — vì đồ vật đã thành ảnh con riêng,
    xếp lớp trong CapCut; để lại trong ảnh nền thì vật bị vẽ hai lần. Beat undergo /
    demonstrate / solo KHÔNG tách ảnh con nên giữ nguyên action đầy đủ (có đồ vật).
    Đúng loại beat present / list đó cũng dùng ô CONCEPT SOLO STYLE (concept_solo_style)
    THAY cho CONCEPT STYLE — vì hai trường hợp cần luật vẽ khác nhau (một bên cấm mọi đồ
    vật, một bên bắt vẽ đồ vật). Ô để trống -> tự lùi về conceptStyle. App KHÔNG tự chế
    thêm chữ nào: toàn bộ câu chữ nằm ở CHANNEL CONFIG.
    25/09/2026: beat [FN: metaphor] (cảnh ẩn dụ vẽ kín khung, Fred có thể xuất hiện nhiều
    lần) dùng ô METAPHOR STYLE (metaphor_style); trống -> lùi về conceptStyle."""
    char = (char or "").strip(); bg = (bg or "").strip(); act = (act or "").strip()
    cam = (cam or "").strip(); tm = (tm or "").strip()
    # Bỏ tag biên tập [SIGN-TITLE: ...] khỏi prompt ảnh (chỉ dùng để overlay CapCut).
    # Cột Action gốc vẫn giữ nguyên tag — đây chỉ tác động lên chuỗi PROMPT sinh ra.
    # 01/10/2026: cả tag [FINDING: …] (dòng chữ kết quả nghiên cứu gõ lên màn hình trong CapCut).
    act = re.sub(r"\s*\[(?:(?:SIGN|HOOK)-TITLE|FINDING)(?::[^\]]*)?\]\s*", " ", act,
                 flags=re.IGNORECASE).strip()
    raw_act = act        # còn nguyên [FN: …] và {cell N} — bộ đọc mảnh cần hai dấu này
    # Beat câu nối: ảnh lấy sẵn từ THƯ VIỆN TƯ THẾ -> không có prompt để gen.
    if pose_name_of(raw_act):
        return ""
    # Đợt 2: cờ [FN: …] đầu action và ô {cell N} sau mỗi mảnh chỉ dành cho máy (draft CapCut +
    # prompt ảnh con) — lọc khỏi prompt ảnh nền. Cột Action gốc vẫn giữ nguyên.
    act = re.sub(r"^\s*\[FN:[^\]]*\]\s*", "", act, flags=re.IGNORECASE)
    act = re.sub(r"\s*" + CELL_MARK_RE.pattern, "", act, flags=re.IGNORECASE).strip()
    if not char and not bg and not act:
        return ""
    names = [n.strip() for n in char.split(",") if n.strip()]
    head = ", ".join(f"[{n}]" for n in names) if names else f"[{char}]"
    shot = (cam[0].upper() + cam[1:] + ". ") if cam else ""
    body = act
    solo_style = ""
    if concept_style is not None:
        fn, pose = _concept_base_pose(raw_act)
        if fn in ELEMENT_FN and pose:        # present / list -> ảnh nền chỉ có mình Fred
            body = pose
            solo_style = (concept_solo_style or "").strip()
        elif fn == "metaphor":               # cảnh ẩn dụ toàn khung -> ô METAPHOR STYLE
            solo_style = (metaphor_style or "").strip()
    elif has_scene_pieces(raw_act):
        # 24/09/2026: cảnh đời thường có mảnh {cell N} (SCENE PIECES) -> mảnh thành ảnh con
        # riêng, ảnh nền chỉ giữ STATE + thay đổi của Fred, không thì vật bị vẽ hai lần.
        _fn, pose = _concept_base_pose(raw_act)
        if pose:
            body = pose
    # Scene chỉ có ĐÚNG 1 nhân vật (mọi scene CONCEPT + scene thường solo) -> bỏ token
    # [tên] MỞ ĐẦU action để prompt không lặp tên nhân vật: head đã có "[tên] in [bg]",
    # nếu action lại bắt đầu bằng "[tên]" thì thành "[fred] in [fred-white], [fred] ..."
    # -> model dễ vẽ 2 người / sai bố cục. Scene NHIỀU nhân vật GIỮ NGUYÊN brackets trong
    # action (cần để gán đúng ai làm gì, vd "[fred] ... [modern-boss] frowning").
    if len(names) == 1:
        stripped = re.sub(r"^\s*\[" + re.escape(names[0]) + r"\]\s*,?\s*", "",
                          body, flags=re.IGNORECASE)
        if stripped:                         # đừng để action rỗng nếu action chỉ là "[fred]"
            body = stripped
    if concept_style is not None:            # scene CONCEPT: conceptStyle thay sceneStyle
        light = ""
        # beat present/list -> CONCEPT SOLO STYLE, beat metaphor -> METAPHOR STYLE;
        # ô trống thì lùi về CONCEPT STYLE
        style = solo_style or (concept_style or "").strip() or (scene_style or "").strip()
    else:                                    # scene thường
        lc = _light_clause(tm, day_light, night_light)
        light = lc + ". " if lc else ""
        style = (scene_style or "").strip()
    return _one_line(_tidy_dots(f"{head} in [{bg}], {body}. {shot}{light}{style}")).strip()


