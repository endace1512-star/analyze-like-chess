def load_profile(name):
    p = _path_for(name)
    data = None
    if p.exists():
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            data = None
    if data is None:
        for f in PROFILES_DIR.glob("*.json"):
            try:
                d = json.loads(f.read_text(encoding="utf-8"))
                if d.get("name") == name:
                    data = d; break
            except Exception:
                continue
    if data is None:
        data = _empty_profile(name)
    base = _empty_profile(name)
    for k, v in base.items():
        data.setdefault(k, v)
    data.setdefault("style", {})
    for k in ("sceneStyle", "bgStyle", "thumbStyle", "refStyle"):
        data["style"].setdefault(k, "")
    # Hồ sơ cũ chưa có ô ELEMENT STYLE -> điền khuôn mặc định (người dùng sửa được ở CHANNEL CONFIG)
    data["style"].setdefault("elementStyle", ELEMENT_STYLE_DEFAULT)
    # 02/10/2026: hồ sơ cũ chưa có ô POV STYLE -> điền khuôn mặc định (sửa ở CHANNEL CONFIG)
    data["style"].setdefault("povStyle", POV_STYLE_DEFAULT)
    # Hồ sơ cũ chưa có ô DAY LIGHT / NIGHT LIGHT -> điền giá trị khởi tạo (sửa ở CHANNEL CONFIG)
    data["style"].setdefault("dayLight", DAY_LIGHT_DEFAULT)
    data["style"].setdefault("nightLight", NIGHT_LIGHT_DEFAULT)
    data.setdefault("style_saved_at", "")
    vs = data.setdefault("vo_settings", {})
    for k, v in base["vo_settings"].items():
        vs.setdefault(k, v)
    # KHÔNG tự sửa sceneStyle: dùng ĐÚNG những gì người dùng nhập (có hay không "NO TEXT"
    # là do người dùng quyết định — app không tự thêm/bớt gì vào ô style).
    # Migrate protagonist: chỉ bảo đảm có đủ KHOÁ cho schema mới, KHÔNG tự sinh nội dung
    # conceptStyle. conceptStyle để trống thì scene CONCEPT tự fallback về sceneStyle
    # (xem build_prompt_row) — vẫn dùng đúng input, không bịa thêm.
    for p in data.get("protagonists", []):
        if not isinstance(p, dict):
            continue
        if "use_concept" not in p:                 # kế thừa từ plain_bg cũ
            p["use_concept"] = bool(p.get("plain_bg", False))
        p.setdefault("conceptStyle", "")
        p.setdefault("conceptSoloStyle", "")       # beat present/list; trống -> lùi về conceptStyle
        p.setdefault("metaphorStyle", "")          # beat [FN: metaphor]; trống -> lùi về conceptStyle
        p.setdefault("bg_name", "")
        p.setdefault("bgStyle", "")
    return data


