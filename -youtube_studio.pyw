    def _asset_copy_selected(self):
        texts = self.dt_chars.selected_outputs() + self.dt_bg.selected_outputs()
        if not texts:
            return messagebox.showinfo("CHƯA CHỌN", "Tích ô đầu dòng ở bảng CHARACTER và/hoặc BACKGROUND.")
        self.clipboard_clear()
        self.clipboard_append("\n".join(texts))
        self._set_status(f"Đã copy REF_PROMPT của {len(texts)} hàng (cả 2 bảng).")

    def _asset_delete_selected(self):
        c_m = [i for i in self.dt_chars.tree.get_children()
               if i in self.dt_chars.checked and i.startswith("m")]
        b_m = [i for i in self.dt_bg.tree.get_children()
               if i in self.dt_bg.checked and i.startswith("m")]
        total = len(c_m) + len(b_m)
        if total == 0:
            return messagebox.showinfo("CHƯA CHỌN", "Tích ô đầu dòng ở CHARACTER và/hoặc BACKGROUND (không tính hàng khoá).")
        if not messagebox.askyesno("XÁC NHẬN XOÁ", f"Xoá {total} hàng đã chọn (cả 2 bảng)?"):
            return
        self._snapshot()
        d1, l1 = self.dt_chars._delete_checked_silent()
        d2, l2 = self.dt_bg._delete_checked_silent()
        self.on_data_changed()
        skip = l1 + l2
        extra = f" (bỏ {skip} hàng khoá)" if skip else ""
        self._set_status(f"Đã xoá {d1 + d2} hàng (cả 2 bảng){extra}.")

    def _locked_chars(self):
        rows = []
        for i, p in enumerate(self.prof.get("protagonists", [])):
            cs = p.get("charStyle", "") or ""
            rows.append({"alias": f"character{i+1}", "t_goc": p.get("name", ""),
                         "subject": cs, "ref_prompt": cs})
        return rows

    def _recompute_chars(self, model):
        base = len(self.prof.get("protagonists", []))
        ref_style = self.prof["style"].get("refStyle", "") or ""
        out = []
        for i, c in enumerate(model):
            subj = (c.get("subject", "") or "").strip()
            if subj:
                lead = subj if subj[-1] in ".!?" else subj + "."
                ref = _one_line(_tidy_dots(lead + " " + ref_style))
            else:
                ref = ""
            out.append({"alias": f"character{base+i+1}", "t_goc": c.get("t_goc", ""),
                        "subject": subj, "ref_prompt": ref})
        return out

    def _locked_bg(self):
        rows = []
        for p in self.prof.get("protagonists", []):
            nm = (p.get("bg_name") or "").strip()
            if not nm:
                continue
            bgs = p.get("bgStyle", "") or ""
            if p.get("use_concept"):
                # Nền CONCEPT (vd fred-white) = nền TRẮNG TRƠN: KHÔNG gen bằng text-to-image
                # (model hay chế thêm phòng/sàn/gradient -> nhiễu) và build KHÔNG cần file này
                # (make_video khớp ảnh theo SỐ scene, không theo tên nền). Nền trắng đã bake
                # trong conceptStyle của từng scene CONCEPT -> để ref_prompt RỖNG (COPY
                # REF_PROMPT tự bỏ qua). Cần 1 file trắng đặc thì chạy 1 lần:
                #   ffmpeg -f lavfi -i color=white:s=1920x1080 -frames:v 1 <bg_name>.png
                note = ("Nền trắng trơn (concept backdrop) — KHÔNG cần gen, đã bake trong "
                        "conceptStyle. Cần file trắng: ffmpeg -f lavfi -i "
                        "color=white:s=1920x1080 -frames:v 1 " + nm + ".png")
                rows.append({"t_goc": nm, "subject": note, "ref_prompt": ""})
            elif bgs.strip():
                rows.append({"t_goc": nm, "subject": bgs, "ref_prompt": bgs})
        return rows

    def _recompute_bg(self, model):
        bg_style = self.prof["style"].get("bgStyle", "") or ""
        out = []
        for b in model:
            subj = b.get("subject", "") or ""
            ref = _one_line(subj + ". " + bg_style) if subj.strip() else ""
            out.append({"t_goc": b.get("t_goc", ""), "subject": subj, "ref_prompt": ref})
        return out

