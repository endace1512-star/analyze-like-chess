#  PasteDialog — dán 1 block để import
# ════════════════════════════════════════════════════════════════════════════
class PasteDialog(tk.Toplevel):
    def __init__(self, parent, title, label):
        super().__init__(parent)
        self.title(title)
        self.result = None
        self.transient(parent.winfo_toplevel())
        self.resizable(True, True)
        frm = ttk.Frame(self, padding=12)
        frm.pack(fill="both", expand=True)
        ttk.Label(frm, text=label, wraplength=560, justify="left").pack(anchor="w")
        self.txt = scrolledtext.ScrolledText(frm, width=74, height=16, wrap="word")
        self.txt.pack(fill="both", expand=True, pady=8)
        btns = ttk.Frame(frm)
        btns.pack(fill="x")
        ttk.Button(btns, text="NHẬP", command=self._ok).pack(side="right")
        ttk.Button(btns, text="HUỶ", command=self.destroy).pack(side="right", padx=6)
        self.update_idletasks()
        w, h = self.winfo_reqwidth(), self.winfo_reqheight()
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        self.geometry(f"+{max(0,(sw-w)//2)}+{max(0,(sh-h)//2)}")
        self.grab_set()
        self.txt.focus_set()
        self.wait_window(self)

    def _ok(self):
        self.result = self.txt.get("1.0", "end")
        self.destroy()


# ════════════════════════════════════════════════════════════════════════════
#  DataTab — Treeview + checkbox + inline-edit (double-click) + copy/delete selected
# ════════════════════════════════════════════════════════════════════════════
class DataTab(ttk.Frame):
    def __init__(self, parent, app, columns, get_model, recompute,
                 locked_rows=None, output_key=None, unit="dòng", locked_hint="",
                 show_copy=True, show_delete=True):
        super().__init__(parent, padding=6)
        self.app = app
        self.columns = columns
        self.get_model = get_model
        self.recompute = recompute
        self.locked_rows = locked_rows or (lambda: [])
        self.output_key = output_key or columns[-1]["key"]
        self.unit = unit
        self.locked_hint = locked_hint
        self.show_copy = show_copy
        self.show_delete = show_delete
        self._display = []
        self.checked = set()
        self._editor = None
        self._datakeys = [c["key"] for c in columns]
        self._spec = {c["key"]: c for c in columns}
        self._build()

    def _build(self):
        self.toolbar = ttk.Frame(self)
        self.toolbar.pack(fill="x", pady=(0, 6))
        ttk.Button(self.toolbar, text="+", width=3, style="Green.TButton",
                   command=self.add_row).pack(side="left")
        if self.show_copy:
            ttk.Button(self.toolbar, text=f"COPY SELECTED {self.output_key.upper()}",
                       style="Copy.TButton", command=self.copy_selected).pack(side="left", padx=6)
        if self.show_delete:
            ttk.Button(self.toolbar, text="DELETE SELECTED", style="Del.TButton",
                       command=self.delete_selected).pack(side="left",
                                                          padx=(0 if self.show_copy else 6, 0))
        self.count_lbl = ttk.Label(self.toolbar, text="", style="Hint.TLabel")
        self.count_lbl.pack(side="right")

        body = ttk.Frame(self)
        body.pack(fill="both", expand=True)
        self.tree = ttk.Treeview(body, columns=self._datakeys, show="tree headings",
                                 selectmode="browse")
        self.tree.heading("#0", image=self.app.img_uncheck, anchor="center")
        self.tree.column("#0", width=44, minwidth=44, anchor="center", stretch=False)
        for c in self.columns:
            self.tree.heading(c["key"], text=c["label"])
            is_out = (c["key"] == self.output_key)
            self.tree.column(c["key"], width=c.get("width", 120),
                             minwidth=(150 if is_out else 40),
                             anchor="w", stretch=is_out)
        self.tree.tag_configure("locked", foreground="#8a8a8a")
        # Dòng vừa nhập từ NHẬP ASSET: nền xanh lá nhạt (highlight). Dòng thêm bằng nút "+"
        # KHÔNG mang cờ _new nên không bị tô. Cờ _new được lưu vào hồ sơ nên giữ qua lần mở lại.
        self.tree.tag_configure("new", background="#cdeccd")
        # Dòng ẢNH CON element (001a, 001b…) tính từ Action của scene gốc: chữ xanh, không sửa được.
        self.tree.tag_configure("virtual", foreground="#2f6db5")
        ysb = ttk.Scrollbar(body, orient="vertical", command=self.tree.yview)
        xsb = ttk.Scrollbar(body, orient="horizontal", command=self.tree.xview)
        self.tree.configure(yscrollcommand=ysb.set, xscrollcommand=xsb.set)
        self.tree.grid(row=0, column=0, sticky="nsew")
        ysb.grid(row=0, column=1, sticky="ns")
        xsb.grid(row=1, column=0, sticky="ew")
        body.rowconfigure(0, weight=1)
        body.columnconfigure(0, weight=1)
        self.tree.bind("<Button-1>", self._on_click, add="+")
        self.tree.bind("<Double-1>", self._on_double, add="+")

    def _cell(self, row, key):
        v = row.get(key, "")
        return "" if v is None else str(v).replace("\n", " ⏎ ")

    def _img(self, iid):
        if iid.startswith("l"):       # dòng khoá → không hiện checkbox
            return self.app.img_blank
        return self.app.img_check if iid in self.checked else self.app.img_uncheck

    # ---- hiển thị ----
    def refresh(self):
        self._close_editor()
        self.tree.delete(*self.tree.get_children())
        self._display = []
        locked = self.locked_rows()
        model_src = self.get_model()
        model_disp = self.recompute(model_src)
        for i, row in enumerate(locked):
            iid = f"l{i}"
            self.tree.insert("", "end", iid=iid, image=self._img(iid),
                             values=[self._cell(row, k) for k in self._datakeys], tags=("locked",))
            self._display.append(row)
        mi = 0                      # chỉ số dòng THẬT trong model (bỏ qua dòng ảnh con)
        for row in model_disp:
            if row.get("_virtual"):
                iid = f"e{len(self._display)}"
                tags = ("virtual",)
            else:
                iid = f"m{mi}"
                tags = ("new",) if (mi < len(model_src) and model_src[mi].get("_new")) else ()
                mi += 1
            self.tree.insert("", "end", iid=iid, image=self._img(iid),
                             values=[self._cell(row, k) for k in self._datakeys], tags=tags)
            self._display.append(row)
        self._update_header_glyph()
        self.refresh_count()

    def _update_header_glyph(self):
        ids = [i for i in self.tree.get_children() if not i.startswith("l")]
        allon = bool(ids) and all(i in self.checked for i in ids)
        self.tree.heading("#0", image=self.app.img_check if allon else self.app.img_uncheck)

    def refresh_count(self):
        ids = self.tree.get_children()
        nlock = sum(1 for i in ids if i.startswith("l"))
        nvirt = sum(1 for i in ids if i.startswith("e"))
        nmod = len(ids) - nlock - nvirt
        extra = f"  ·  {nlock} khoá (sửa ở Channel Config)" if nlock else ""
        if nvirt:
            extra += f"  ·  {nvirt} ảnh con element"
        sel = f"  ·  chọn {len(self.checked)}" if self.checked else ""
        self.count_lbl.configure(text=f"{nmod} {self.unit}{extra}{sel}")

    # ---- checkbox ----
    def _on_click(self, event):
        region = self.tree.identify_region(event.x, event.y)
        col = self.tree.identify_column(event.x)
        if region == "heading" and col == "#0":
            self.toggle_all()
            return "break"
        if region == "tree":
            iid = self.tree.identify_row(event.y)
            if iid and iid.startswith("l"):   # dòng khoá: không chọn được
                return "break"
            if iid:
                if iid in self.checked:
                    self.checked.discard(iid)
                else:
                    self.checked.add(iid)
                self.tree.item(iid, image=self._img(iid))
                self._update_header_glyph()
                self.refresh_count()
                return "break"

    def toggle_all(self):
        ids = [i for i in self.tree.get_children() if not i.startswith("l")]
        if ids and all(i in self.checked for i in ids):
            self.checked.clear()
        else:
            self.checked = set(ids)
        for i in self.tree.get_children():
            self.tree.item(i, image=self._img(i))
        self._update_header_glyph()
        self.refresh_count()

    # ---- inline edit ----
    def _on_double(self, event):
        if self.tree.identify_region(event.x, event.y) not in ("cell", "tree"):
            return
        col = self.tree.identify_column(event.x)
        iid = self.tree.identify_row(event.y)
        if not iid or not col or col == "#0":
            return
        cidx = int(col[1:]) - 1
        if cidx < 0 or cidx >= len(self.columns):
            return
        key = self.columns[cidx]["key"]
        if not self._spec[key].get("edit"):
            return
        if iid.startswith("l"):
            messagebox.showinfo("HÀNG KHOÁ", self.locked_hint or "Sửa ở tab CHANNEL CONFIG.")
            return
        if iid.startswith("e"):
            messagebox.showinfo("DÒNG ẢNH CON",
                                "Dòng ảnh con (element) được tính từ cột Action của scene gốc ngay trên.\n"
                                "Muốn đổi mô tả / ô: sửa Action của scene đó (mỗi mảnh kết thúc bằng {cell N}).")
            return
        self._open_editor(iid, col, key)

    def _open_editor(self, iid, col, key):
        self._close_editor()
        bbox = self.tree.bbox(iid, col)
        if not bbox:
            return
        x, y, w, h = bbox
        midx = int(iid[1:])
        cur = self.get_model()[midx].get(key, "") or ""
        e = tk.Entry(self.tree)
        e.insert(0, str(cur))
        e.select_range(0, "end")
        e.place(x=x, y=y, width=w, height=h)
        e.focus_set()

        def commit(_=None):
            if self._editor is None:
                return
            val = e.get()
            self._close_editor()
            if val != cur:
                self.app._snapshot()
                self.get_model()[midx][key] = val
                self.app.on_data_changed()

        e.bind("<Return>", commit)
        e.bind("<KP_Enter>", commit)
        e.bind("<Escape>", lambda _e: self._close_editor())
        e.bind("<FocusOut>", commit)
        self._editor = e

    def _close_editor(self):
        if self._editor is not None:
            ed = self._editor
            self._editor = None
            try:
                ed.destroy()
            except Exception:
                pass

    # ---- thao tác ----
    def add_row(self):
        self.app._snapshot()
        self.get_model().append({c["key"]: "" for c in self.columns if c.get("edit")})
        self.app.on_data_changed()
        last = f"m{len(self.get_model())-1}"
        try:
            self.tree.see(last)
            self.tree.selection_set(last)
        except Exception:
            pass

    def selected_outputs(self):
        out = []
        for i in self.tree.get_children():
            if i in self.checked:
                v = str(self._display[self.tree.index(i)].get(self.output_key, ""))
                if v.strip():
                    out.append(v)
        return out

    def copy_selected(self):
        texts = self.selected_outputs()
        if not texts:
            return messagebox.showinfo("CHƯA CHỌN", "Tích ô đầu dòng để chọn hàng cần copy.")
        self.app.clipboard_clear()
        self.app.clipboard_append("\n".join(texts))
        self.app._set_status(f"Đã copy {self.output_key} của {len(texts)} hàng.")

    def delete_selected(self):
        m_ids = [i for i in self.tree.get_children() if i in self.checked and i.startswith("m")]
        l_ids = [i for i in self.checked if i.startswith("l")]
        if not m_ids:
            if l_ids:
                return messagebox.showinfo("HÀNG KHOÁ", "Chỉ chọn hàng khoá (protagonist) — sửa ở CHANNEL CONFIG.")
            return messagebox.showinfo("CHƯA CHỌN", "Tích ô đầu dòng để chọn hàng cần xoá.")
        extra = f"\n(Bỏ qua {len(l_ids)} hàng khoá.)" if l_ids else ""
        if not messagebox.askyesno("XÁC NHẬN XOÁ", f"Xoá {len(m_ids)} {self.unit} đã chọn?{extra}"):
            return
        self.app._snapshot()
        model = self.get_model()
        for ix in sorted((int(i[1:]) for i in m_ids), reverse=True):
            del model[ix]
        self.checked.clear()
        self.app.on_data_changed()
        self.app._set_status(f"Đã xoá {len(m_ids)} {self.unit}.")

    def _delete_checked_silent(self):
        m_ids = [i for i in self.tree.get_children() if i in self.checked and i.startswith("m")]
        l_ids = [i for i in self.checked if i.startswith("l")]
        model = self.get_model()
        for ix in sorted((int(i[1:]) for i in m_ids), reverse=True):
            del model[ix]
        self.checked.clear()
        return len(m_ids), len(l_ids)


