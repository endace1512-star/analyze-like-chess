    # ═════════ IMPORTS ═════════
    def _import_asset(self):
        text = PasteDialog(self, "NHẬP ASSET",
                           "Dán block CHAR+BG (từ /qcscene) và/hoặc block SUBJECTS (từ /asset). "
                           "App tự chia về CHARACTER / BACKGROUND theo header.\n"
                           "Hoặc dán danh sách tên thuần (không header) — app sẽ hỏi đó là "
                           "CHARACTER hay BACKGROUND.").result
        if not text:
            return
        c_names, b_names = parse_charbg(text)
        c_pairs, b_pairs = parse_subjects(text)

        # Không có header nào -> tên thuần -> hỏi đích đến
        if "===" not in text and not (c_names or b_names or c_pairs or b_pairs):
            plain = parse_plain_names(text)
            if not plain:
                return messagebox.showwarning("KHÔNG THẤY", "Không thấy tên/subject asset nào.")
            dest = self._ask_asset_dest()
            if dest is None:
                return
            if dest == "char":
                c_names = plain
            else:
                b_names = plain

        if not (c_names or b_names or c_pairs or b_pairs):
            return messagebox.showwarning("KHÔNG THẤY", "Không thấy tên/subject asset nào.")

        prot_c = {(p.get("name") or "").strip() for p in self.prof.get("protagonists", [])}
        prot_b = {(p.get("bg_name") or "").strip() for p in self.prof.get("protagonists", [])}
        self._snapshot()
        # Bỏ highlight của batch nhập TRƯỚC (chỉ batch mới nhất được tô xanh). Nút "+" không
        # đi qua đây nên dòng thêm bằng "+" không bị ảnh hưởng.
        for r in self.prof.setdefault("characters", []):
            r.pop("_new", None)
        for r in self.prof.setdefault("backgrounds", []):
            r.pop("_new", None)
        msgs = []
        if c_names or c_pairs:
            model = self.prof.setdefault("characters", [])
            an, fl, sk, ad = self._apply_names_subjects(model, "t_goc", c_names, c_pairs, prot_c)
            # KHÔNG đẩy dòng mới lên đầu nữa (giữ nguyên vị trí để alias characterN không lệch);
            # dòng mới vẫn được tô xanh nhờ cờ _new.
            msgs.append(f"CHARACTER: +tên {an}, +subject {fl}, bỏ {sk}, append {ad}")
        if b_names or b_pairs:
            model = self.prof.setdefault("backgrounds", [])
            an, fl, sk, ad = self._apply_names_subjects(model, "t_goc", b_names, b_pairs, prot_b)
            # KHÔNG đẩy dòng mới lên đầu nữa (giữ highlight bằng cờ _new).
            msgs.append(f"BACKGROUND: +tên {an}, +subject {fl}, bỏ {sk}, append {ad}")
        self.on_data_changed()
        self._set_status(" | ".join(msgs) if msgs else "Không có gì để nhập.")

    def _ask_asset_dest(self):
        """Tên-thuần không header -> hỏi thuộc CHARACTER hay BACKGROUND. Trả 'char'|'bg'|None."""
        dlg = tk.Toplevel(self)
        dlg.title("CHARACTER hay BACKGROUND?")
        dlg.transient(self)
        dlg.grab_set()
        frm = ttk.Frame(dlg, padding=14)
        frm.pack(fill="both", expand=True)
        ttk.Label(frm, text="Danh sách tên không có header.\nĐây là CHARACTER hay BACKGROUND?",
                  justify="left").pack(anchor="w", pady=(0, 12))
        choice = {"v": None}
        btns = ttk.Frame(frm)
        btns.pack(fill="x")

        def pick(v):
            choice["v"] = v
            dlg.destroy()
        ttk.Button(btns, text="CHARACTER", style="Green.TButton",
                   command=lambda: pick("char")).pack(side="left", padx=4)
        ttk.Button(btns, text="BACKGROUND", style="Green.TButton",
                   command=lambda: pick("bg")).pack(side="left", padx=4)
        ttk.Button(btns, text="HUỶ", command=lambda: pick(None)).pack(side="right", padx=4)
        dlg.update_idletasks()
        w, hh = dlg.winfo_reqwidth(), dlg.winfo_reqheight()
        sw, sh = dlg.winfo_screenwidth(), dlg.winfo_screenheight()
        dlg.geometry(f"+{max(0, (sw - w) // 2)}+{max(0, (sh - hh) // 2)}")
        self.wait_window(dlg)
        return choice["v"]

    def _apply_names_subjects(self, model, key, names, pairs, skip):
        row_of = {(r.get(key) or "").strip(): r for r in model}
        added_names = 0
        for n in names:
            if n in skip or n in row_of:
                continue
            nr = {key: n, "subject": "", "_new": True}       # dòng mới → highlight
            model.append(nr); row_of[n] = nr; added_names += 1
        filled = skipped = appended = 0
        for name, subj in pairs:
            if name in skip:
                continue
            if name in row_of:
                if not (row_of[name].get("subject") or "").strip():
                    row_of[name]["subject"] = subj
                    row_of[name]["_new"] = True                # dòng CẬP NHẬT cũng coi là mới
                    filled += 1
                else:
                    skipped += 1
            else:
                nr = {key: name, "subject": subj, "_new": True}
                model.append(nr); row_of[name] = nr; appended += 1
        return added_names, filled, skipped, appended

    def _import_scenes(self):
        text = PasteDialog(self, "NHẬP SCENES",
                           "Dán block SCENES từ /scenes (tsv 6 cột vo/char/bg/action/camera/time):").result
        if not text:
            return
        grid = parse_scenes(text)
        if not grid:
            return messagebox.showwarning("KHÔNG THẤY", "Không thấy dòng scene nào.")
        cur = self.prof.get("prompts", [])
        if cur and not messagebox.askyesno("GHI ĐÈ?",
                f"Prompts đang có {len(cur)} scene. Nhập {len(grid)} scene mới sẽ GHI ĐÈ toàn bộ. Tiếp tục?"):
            return
        self._snapshot()
        self.prof["prompts"] = [{"vo": r[0], "char": r[1], "bg": r[2],
                                 "action": r[3], "camera": r[4], "time": r[5]} for r in grid]
        self.dt_prompts.checked.clear()
        self.on_data_changed()
        self._set_status(f"SCENES: {len(grid)} scene → Prompts (ghi đè).")

